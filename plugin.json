{
  "manifest_version": 2,
  "id": "mattermost-readreceipts",
  "name": "Read Receipts",
  "description": "Explicit per-message read receipts with continuous visibility tracking.",
  "version": "1.1.1",
  "min_server_version": "9.5.0",
  "server": {
    "executables": {
      "linux-amd64": "plugin-linux-amd64",
      "linux-arm64": "plugin-linux-arm64"
    }
  },
  "webapp": {
    "bundle_path": "main.js"
  },
  "settings_schema": {
    "settings": [
      {
        "key": "Enable",
        "display_name": "Enable Read Receipts",
        "type": "bool",
        "help_text": "When true, per-message read receipts are active",
        "default": true
      },
      {
        "key": "VisibilityThresholdMs",
        "display_name": "Visibility Threshold (ms)",
        "type": "number",
        "help_text": "Time in milliseconds a message must be visible before marking as read",
        "default": 2000
      },
      {
        "key": "RetentionDays",
        "display_name": "Receipt Retention (days)",
        "type": "number",
        "help_text": "Number of days to retain read receipts in the database",
        "default": 30
      },
      {
        "key": "EnableCleanup",
        "display_name": "Enable automatic receipt cleanup",
        "type": "bool",
        "default": false,
        "help_text": "Opt in to hourly deletion according to RetentionDays. Disabled by default to preserve history."
      },
      {
        "key": "LogLevel",
        "display_name": "Log Level",
        "type": "dropdown",
        "help_text": "Set the logging level for the plugin",
        "default": "info",
        "options": [
          {
            "display_name": "debug",
            "value": "debug"
          },
          {
            "display_name": "info",
            "value": "info"
          },
          {
            "display_name": "error",
            "value": "error"
          }
        ]
      }
    ]
  }
}
