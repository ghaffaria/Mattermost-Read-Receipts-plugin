+
+import TestHelper from '@test/test_helper';
+
+import type {Client} from '@client/rest';
+
+let client: Client;
+let fetch: jest.Mock;
+
+beforeEach(() => {
+    client = TestHelper.createClient();
+    fetch = jest.fn();
+    client.doFetch = fetch;
+});
+
+describe('read receipt plugin REST contract', () => {
+    it('should use the existing plugin routes and per-message body rather than a channel read cursor', async () => {
+        const config = {enable: true, visibility_threshold_ms: 2000};
+        fetch.mockResolvedValueOnce(config).mockResolvedValueOnce([]).mockResolvedValueOnce({status: 'ok'});
+
+        expect(await client.rrGetConfig()).toEqual(config);
+        expect(await client.rrGetReceipts('channel', ['first', 'reply'])).toEqual([]);
+        await client.rrMarkRead({id: 'reply', channelId: 'reply-channel', userId: 'author'});
+
+        expect(client.doFetch).toHaveBeenNthCalledWith(1, '/plugins/mattermost-readreceipts/api/v1/config', {method: 'get', noRetry: true, timeoutInterval: 10000});
+        expect(client.doFetch).toHaveBeenNthCalledWith(2, '/plugins/mattermost-readreceipts/api/v1/receipts?channel_id=channel&post_ids=first,reply', {method: 'get', noRetry: true, timeoutInterval: 10000});
+        expect(client.doFetch).toHaveBeenNthCalledWith(3, '/plugins/mattermost-readreceipts/api/v1/read', {
+            method: 'post',
+            body: {message_id: 'reply', channel_id: 'reply-channel'},
+            noRetry: true,
+            timeoutInterval: 10000,
+        });
+    });
+
+    it('should not turn an empty visible set into an unfiltered channel-history request', async () => {
+        expect(await client.rrGetReceipts('channel', [])).toEqual([]);
+        expect(client.doFetch).not.toHaveBeenCalled();
+    });
+
+    it('should reject a batch larger than the server contract without sending a partial request', async () => {
+        const ids = Array.from({length: 201}, (_, index) => `post-${index}`);
+        await expect(client.rrGetReceipts('channel', ids)).rejects.toThrow('at most 200');
+        expect(client.doFetch).not.toHaveBeenCalled();
+    });
+
+    it('should reject incompatible plugin responses rather than treating them as configuration or readers', async () => {
+        fetch.mockResolvedValueOnce({enabled: true}).mockResolvedValueOnce([{user_id: 'reader'}]);
+        await expect(client.rrGetConfig()).rejects.toThrow('Invalid read receipt configuration');
+        await expect(client.rrGetReceipts('channel', ['post'])).rejects.toThrow('Invalid read receipt history');
+    });
+});
