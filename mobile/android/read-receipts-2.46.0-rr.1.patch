@@ -0,0 +1,97 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {useDatabase} from '@nozbe/watermelondb/react';
+import React, {useEffect, useMemo, useState} from 'react';
+import {defineMessages, useIntl} from 'react-intl';
+
+import {fetchMissingProfilesByIds} from '@actions/remote/user';
+import FormattedText from '@components/formatted_text';
+import {usePostConfig} from '@context/post_config';
+import {useServerUrl} from '@context/server';
+import {useTheme} from '@context/theme';
+import {queryUsersById} from '@queries/servers/user';
+import {changeOpacity, makeStyleSheetFromTheme} from '@utils/theme';
+import {typography} from '@utils/typography';
+import {displayUsername} from '@utils/user';
+
+import {useReadReceiptReaders} from './context';
+
+import type {Receipt} from './types';
+import type UserModel from '@typings/database/models/servers/user';
+
+const messages = defineMessages({
+    seenBy: {id: 'mobile.read_receipts.seen_by', defaultMessage: '✓✓ Seen by {readers}'},
+    unknownReaders: {id: 'mobile.read_receipts.unknown_readers', defaultMessage: '{count, plural, one {# person} other {# people}}'},
+});
+
+const getStyleSheet = makeStyleSheetFromTheme((theme: Theme) => ({
+    indicator: {
+        color: changeOpacity(theme.centerChannelColor, 0.64),
+        marginTop: 3,
+        marginBottom: 3,
+        ...typography('Body', 75),
+    },
+}));
+
+const ReceiptReaders = ({postId, receipts}: {postId: string; receipts: readonly Receipt[]}) => {
+    const database = useDatabase();
+    const serverUrl = useServerUrl();
+    const theme = useTheme();
+    const intl = useIntl();
+    const {teammateNameDisplay} = usePostConfig();
+    const [profiles, setProfiles] = useState<readonly UserModel[]>([]);
+    const readerIds = useMemo(() => [...new Set(receipts.map((receipt) => receipt.UserID))].sort(), [receipts]);
+    const readerKey = readerIds.join(',');
+
+    useEffect(() => {
+        setProfiles([]);
+        if (!readerKey) {
+            return undefined;
+        }
+        const ids = readerKey.split(',');
+        const subscription = queryUsersById(database, ids).
+            observeWithColumns(['username', 'first_name', 'last_name', 'nickname']).
+
+            // Watermelon models mutate in place, so publish a fresh array even
+            // when only an existing reader's name changed.
+            subscribe({next: (users) => setProfiles([...users]), error: () => setProfiles([])});
+
+        // Existing action fetches only missing profiles and writes through the operator.
+        fetchMissingProfilesByIds(serverUrl, ids);
+        return () => subscription.unsubscribe();
+    }, [database, readerKey, serverUrl]);
+
+    const names = profiles.filter((profile) => readerIds.includes(profile.id)).map((profile) => (
+        displayUsername(profile, intl.locale, teammateNameDisplay)
+    ));
+    const missing = readerIds.length - names.length;
+    if (missing) {
+        names.push(intl.formatMessage(messages.unknownReaders, {count: missing}));
+    }
+
+    return (
+        <FormattedText
+            {...messages.seenBy}
+            values={{readers: intl.formatList(names)}}
+            style={getStyleSheet(theme).indicator}
+            testID={`read_receipts.indicator.${postId}`}
+        />
+    );
+};
+
+const ReadReceiptIndicator = ({postId}: {postId: string}) => {
+    const receipts = useReadReceiptReaders(postId);
+    if (!receipts.length) {
+        return null;
+    }
+    return (
+        <ReceiptReaders
+            key={postId}
+            postId={postId}
+            receipts={receipts}
+        />
+    );
+};
+
+export default ReadReceiptIndicator;
