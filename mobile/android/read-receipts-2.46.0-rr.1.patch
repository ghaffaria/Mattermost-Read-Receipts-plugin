+jest.mock('@utils/config', () => ({hasReliableWebsocket: jest.fn()}));
+jest.mock('@utils/log', () => ({logInfo: jest.fn(), logDebug: jest.fn(), logWarning: jest.fn(), logError: jest.fn()}));
+
+type FactoryResult = Awaited<ReturnType<typeof getOrCreateWebSocketClient>>;
+type NativeHandler = (event: {url: string; message: Record<string, unknown>}) => void;
+
+const deferred = <T, >() => {
+    let resolve: (value: T) => void = () => undefined;
+    let reject: (reason?: unknown) => void = () => undefined;
+    const promise = new Promise<T>((complete, fail) => {
+        resolve = complete;
+        reject = fail;
+    });
+    return {promise, resolve, reject};
+};
+
+/** Native open is deliberately asynchronous: readyState stays CLOSED until emitOpen. */
+const nativeConnection = () => {
+    const handlers: Partial<Record<'open' | 'close' | 'message' | 'error', NativeHandler>> = {};
+    const raw = {
+        url: '',
+        readyState: WebSocketReadyState.CLOSED as WebSocketReadyState,
+        open: jest.fn(),
+        send: jest.fn(),
+        close: jest.fn(async () => {
+            raw.readyState = WebSocketReadyState.CLOSED;
+        }),
+        invalidate: jest.fn(async () => {
+            raw.readyState = WebSocketReadyState.CLOSED;
+        }),
+        onOpen: jest.fn((handler: NativeHandler) => {
+            handlers.open = handler;
+        }),
+        onClose: jest.fn((handler: NativeHandler) => {
+            handlers.close = handler;
+        }),
+        onMessage: jest.fn((handler: NativeHandler) => {
+            handlers.message = handler;
+        }),
+        onError: jest.fn((handler: NativeHandler) => {
+            handlers.error = handler;
+        }),
+    };
+    return {
+        raw,
+        handlers,
+        reply: {client: raw as unknown as FactoryResult['client'], created: true},
+        emitOpen: () => {
+            raw.readyState = WebSocketReadyState.OPEN;
+            handlers.open?.({url: raw.url, message: {code: 101}});
+        },
+        emitClose: () => {
+            raw.readyState = WebSocketReadyState.CLOSED;
+            handlers.close?.({url: raw.url, message: {code: 1000}});
+        },
+        emit: (message: Record<string, unknown>) => handlers.message?.({url: raw.url, message}),
+    };
+};
+
+const factory = jest.mocked(getOrCreateWebSocketClient);
+const config = jest.mocked(getConfigValue);
+const serverUrl = 'https://race.qa.invalid';
+const configValues: Record<string, string> = {WebsocketURL: '', Version: '12.0.1', EnableReliableWebSockets: 'true'};
+const configValue = (key: string) => configValues[key] || '';
+
+describe('WebSocketClient native handshake and reliable stream ownership', () => {
+    let client: WebSocketClient;
+    let first: ReturnType<typeof nativeConnection>;
+    let delivered: jest.Mock;
+
+    const useNative = (connection: ReturnType<typeof nativeConnection>) => {
+        factory.mockImplementation(async (url) => {
+            connection.raw.url = url;
+            return connection.reply;
+        });
+    };
+    const hello = (connection: ReturnType<typeof nativeConnection>, id: string) => connection.emit({
+        seq: 0,
+        event: WebsocketEvents.HELLO,
+        data: {connection_id: id},
+    });
+
+    beforeEach(() => {
+        jest.useFakeTimers({doNotFake: ['nextTick']});
+        factory.mockReset();
+        config.mockReset().mockImplementation(async (_database, key) => configValue(key));
+        jest.mocked(hasReliableWebsocket).mockReturnValue(true);
+        DatabaseManager.serverDatabases[serverUrl] = {database: {}} as unknown as NonNullable<typeof DatabaseManager.serverDatabases[string]>;
+        first = nativeConnection();
+        useNative(first);
+        client = new WebSocketClient(serverUrl, 'qa-token');
+        delivered = jest.fn();
+        client.setEventCallback(delivered);
+    });
+
+    afterEach(() => {
+        client.close(true);
+        client.invalidate();
+        jest.clearAllTimers();
+        jest.useRealTimers();
+        jest.restoreAllMocks();
+    });
+
+    it('coalesces concurrent initialize calls across deferred config and native factory into one open', async () => {
+        const lookup = deferred<string>();
+        const native = deferred<FactoryResult>();
+        config.mockImplementation(async (_database, key) => (key === 'WebsocketURL' ? lookup.promise : configValue(key)));
+        factory.mockImplementation((url) => {
+            first.raw.url = url;
+            return native.promise;
+        });
+        const one = client.initialize();
+        const two = client.initialize();
+        lookup.resolve('');
+        await advanceTimers(0);
+        native.resolve(first.reply);
+        await Promise.all([one, two]);
+        expect(factory).toHaveBeenCalledTimes(1);
+        expect(first.raw.open).toHaveBeenCalledTimes(1);
+        expect(first.raw.readyState).toBe(WebSocketReadyState.CLOSED);
+    });
+
+    it('does not open again when initialize repeats during a pending native handshake', async () => {
+        await client.initialize();
+        expect(first.raw.readyState).toBe(WebSocketReadyState.CLOSED);
+        await client.initialize();
+        expect(factory).toHaveBeenCalledTimes(1);
+        expect(first.raw.open).toHaveBeenCalledTimes(1);
+        first.emitOpen();
+        hello(first, 'first-stream');
+        expect(client.getServerSequence()).toBe(1);
+    });
+
+    it('settles every concurrent initialize caller when native acquisition fails and retries once', async () => {
+        const native = deferred<FactoryResult>();
+        factory.mockReturnValue(native.promise);
+        const one = client.initialize();
+        const two = client.initialize();
+        await advanceTimers(0);
+        native.reject(new Error('Native acquisition failed'));
+        const results = await Promise.allSettled([one, two]);
+        expect(results.map((result) => result.status)).toEqual(['fulfilled', 'fulfilled']);
+        const fresh = nativeConnection();
+        useNative(fresh);
+        await advanceTimers(3000);
+        expect(factory).toHaveBeenCalledTimes(2);
+        expect(fresh.raw.open).toHaveBeenCalledTimes(1);
+    });
+
+    it.each(['close', 'invalidate'] as const)('cancels config lookup on %s even if a fresh initialize clears the stopped state', async (action) => {
+        const lookup = deferred<string>();
+        let holdFirst = true;
+        config.mockImplementation(async (_database, key) => {
+            if (key === 'WebsocketURL' && holdFirst) {
+                holdFirst = false;
+                return lookup.promise;
+            }
+            return configValue(key);
+        });
+        const old = client.initialize();
+        if (action === 'close') {
+            client.close(true);
+        } else {
+            client.invalidate();
+        }
+        const fresh = client.initialize();
+        lookup.resolve('');
+        await Promise.all([old, fresh]);
+        expect(factory).toHaveBeenCalledTimes(1);
+        expect(first.raw.open).toHaveBeenCalledTimes(1);
+        first.emitOpen();
+        hello(first, 'fresh-after-config');
+        first.emit({seq: 1, event: 'posted', data: {post_id: 'fresh-post'}});
+        expect(client.getConnectionId()).toBe('fresh-after-config');
+        expect(client.getServerSequence()).toBe(2);
+    });
+
+    it.each(['close', 'invalidate'] as const)('cancels a deferred native ensure on %s and can initialize a fresh owned client', async (action) => {
+        const native = deferred<FactoryResult>();
+        factory.mockImplementation((url) => {
+            first.raw.url = url;
+            return native.promise;
+        });
+        const old = client.initialize();
+        await advanceTimers(0);
+        expect(factory).toHaveBeenCalledTimes(1);
+        if (action === 'close') {
+            client.close(true);
+        } else {
+            client.invalidate();
+        }
+        native.resolve(first.reply);
+        await old;
+        expect(first.raw.open).not.toHaveBeenCalled();
+        const fresh = nativeConnection();
+        useNative(fresh);
+        await client.initialize();
+        fresh.emitOpen();
+        hello(fresh, 'fresh-after-native');
+        expect(fresh.raw.open).toHaveBeenCalledTimes(1);
+        expect(client.getConnectionId()).toBe('fresh-after-native');
+        expect(client.getServerSequence()).toBe(1);
+    });
+
+    it('ignores queued old native open, close, HELLO and message callbacks after client replacement', async () => {
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'old-stream');
+        const stale = {...first.handlers};
+        client.close(true);
+        client.invalidate();
+        const fresh = nativeConnection();
+        useNative(fresh);
+        await client.initialize();
+        fresh.emitOpen();
+        hello(fresh, 'new-stream');
+        fresh.emit({seq: 1, event: 'posted', data: {post_id: 'owned-post'}});
+        const count = delivered.mock.calls.length;
+        stale.close?.({url: first.raw.url, message: {code: 1000}});
+        stale.open?.({url: first.raw.url, message: {code: 101}});
+        stale.message?.({url: first.raw.url, message: {seq: 0, event: WebsocketEvents.HELLO, data: {connection_id: 'orphan-stream'}}});
+        stale.message?.({url: first.raw.url, message: {seq: 999, event: 'posted', data: {post_id: 'orphan-post'}}});
+        expect(client.isConnected()).toBe(true);
+        expect(client.getConnectionId()).toBe('new-stream');
+        expect(client.getServerSequence()).toBe(2);
+        expect(delivered).toHaveBeenCalledTimes(count);
+        expect(fresh.raw.close).not.toHaveBeenCalled();
+    });
+
+    it('notifies intentional close once so manager background/status cleanup is not lost with stale callbacks', async () => {
+        const closed = jest.fn();
+        client.setCloseCallback(closed);
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'intentional-stop');
+        client.close(true);
+        first.emitClose();
+        await advanceTimers(0);
+        first.emitClose();
+        expect(client.isConnected()).toBe(false);
+        expect(closed).toHaveBeenCalledTimes(1);
+        expect(closed.mock.calls[0][0]).toBeLessThanOrEqual(1);
+    });
+
+    it('keeps shutdown wait bounded while a canceled native acquisition is still pending', async () => {
+        const native = deferred<FactoryResult>();
+        factory.mockReturnValue(native.promise);
+        const pending = client.initialize();
+        await advanceTimers(0);
+        client.close(true);
+        let finished = false;
+        const waiting = client.waitForClose().then(() => {
+            finished = true;
+        });
+        await advanceTimers(500);
+        try {
+            expect(finished).toBe(true);
+        } finally {
+            native.resolve(first.reply);
+            await pending;
+            await advanceTimers(500);
+            await waiting;
+        }
+        expect(first.raw.open).not.toHaveBeenCalled();
+    });
+
+    it('keeps custom read-receipt events in the same contiguous sequence as normal posted events', async () => {
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'normal-stream');
+        first.emit({seq: 1, event: 'custom_mattermost-readreceipts_read_receipt', data: {MessageID: 'message'}});
+        first.emit({seq: 2, event: 'posted', data: {post_id: 'live-message'}});
+        first.emit({seq_reply: 2, status: 'OK', data: {text: WebsocketEvents.PONG}});
+        expect(client.getServerSequence()).toBe(3);
+        expect(delivered.mock.calls.map(([packet]) => packet.seq)).toEqual([0, 1, 2]);
+        expect(first.raw.close).not.toHaveBeenCalled();
+    });
+
+    it('strictly rejects a real reliable sequence gap and restarts with empty connection ID and sequence zero', async () => {
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'gap-stream');
+        first.emit({seq: 1, event: 'posted', data: {post_id: 'before-gap'}});
+        first.emit({seq: 3, event: 'posted', data: {post_id: 'after-missing-event'}});
+        expect(first.raw.close).toHaveBeenCalledTimes(1);
+        expect(delivered.mock.calls.map(([packet]) => packet.seq)).toEqual([0, 1]);
+        expect(client.getConnectionId()).toBe('');
+        expect(client.getServerSequence()).toBe(0);
+        const fresh = nativeConnection();
+        useNative(fresh);
+        first.emitClose();
+        await advanceTimers(3000);
+        expect(factory.mock.calls[factory.mock.calls.length - 1][0]).toBe('wss://race.qa.invalid/api/v4/websocket?connection_id=&sequence_number=0');
+        fresh.emitOpen();
+        hello(fresh, 'recovered-stream');
+        fresh.emit({seq: 1, event: 'posted', data: {post_id: 'recovered-post'}});
+        expect(client.getServerSequence()).toBe(2);
+        expect(delivered.mock.calls.map(([packet]) => packet.data?.post_id).filter(Boolean)).toEqual(['before-gap', 'recovered-post']);
+    });
+
+    it('resumes a normal reliable close using the same connection ID and exact next sequence', async () => {
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'resumable-stream');
+        first.emit({seq: 1, event: 'posted', data: {post_id: 'before-close'}});
+        const fresh = nativeConnection();
+        useNative(fresh);
+        first.emitClose();
+        await advanceTimers(3000);
+        expect(factory.mock.calls[factory.mock.calls.length - 1][0]).toBe('wss://race.qa.invalid/api/v4/websocket?connection_id=resumable-stream&sequence_number=2');
+        fresh.emitOpen();
+        fresh.emit({seq: 2, event: 'posted', data: {post_id: 'replayed-next-event'}});
+        expect(client.getConnectionId()).toBe('resumable-stream');
+        expect(client.getServerSequence()).toBe(3);
+        expect(delivered.mock.calls.map(([packet]) => packet.seq)).toEqual([0, 1, 2]);
+        expect(fresh.raw.close).not.toHaveBeenCalled();
+    });
+
+    it.each(['reject', 'resolve'] as const)('recovers close(false) when the native close promise %ss without emitting CLOSE', async (outcome) => {
+        const closed = jest.fn();
+        client.setCloseCallback(closed);
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'close-without-event');
+        first.emit({seq: 1, event: 'posted', data: {post_id: 'before-close'}});
+        if (outcome === 'reject') {
+            first.raw.close.mockImplementationOnce(async () => {
+                first.raw.readyState = WebSocketReadyState.CLOSED;
+                throw new Error('Native registry is unavailable');
+            });
+        }
+        const fresh = nativeConnection();
+        useNative(fresh);
+        client.close(false);
+        expect(client.isConnected()).toBe(false);
+        await advanceTimers(0);
+        await advanceTimers(500);
+        await advanceTimers(3000);
+        expect(first.raw.close).toHaveBeenCalledTimes(1);
+        expect(first.raw.invalidate).toHaveBeenCalledTimes(1);
+        expect(closed).toHaveBeenCalledTimes(1);
+        expect(factory).toHaveBeenCalledTimes(2);
+        expect(fresh.raw.open).toHaveBeenCalledTimes(1);
+        expect(fresh.raw.url).toBe('wss://race.qa.invalid/api/v4/websocket?connection_id=close-without-event&sequence_number=2');
+        fresh.emitOpen();
+        fresh.emit({seq: 2, event: 'posted', data: {post_id: 'after-close-recovery'}});
+        first.emitClose();
+        await advanceTimers(3000);
+        expect(client.isConnected()).toBe(true);
+        expect(client.getServerSequence()).toBe(3);
+        expect(factory).toHaveBeenCalledTimes(2);
+        expect(delivered.mock.calls.map(([packet]) => packet.data?.post_id).filter(Boolean)).toEqual(['before-close', 'after-close-recovery']);
+    });
+
+    it('retains bounded close recovery when close(false) is requested again before the native close event', async () => {
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'repeated-close');
+        const fresh = nativeConnection();
+        useNative(fresh);
+        client.close(false);
+        await advanceTimers(250);
+        client.close(false);
+        await advanceTimers(500);
+        await advanceTimers(3000);
+        expect(first.raw.close).toHaveBeenCalledTimes(1);
+        expect(first.raw.invalidate).toHaveBeenCalledTimes(1);
+        expect(factory).toHaveBeenCalledTimes(2);
+        expect(fresh.raw.open).toHaveBeenCalledTimes(1);
+    });
+
+    it('evicts a shared SDK wrapper before another app client can acquire it while old native close is pending', async () => {
+        const heldClose = deferred<void>();
+        const fresh = nativeConnection();
+        const cache = new Map<string, ReturnType<typeof nativeConnection>>();
+        const available = [first, fresh];
+        let created = 0;
+        for (const connection of available) {
+            connection.raw.invalidate.mockImplementation(async () => {
+                // The real SDK deletes its URL cache synchronously on invalidate.
+                cache.delete(connection.raw.url);
+                connection.raw.readyState = WebSocketReadyState.CLOSED;
+            });
+        }
+        factory.mockImplementation(async (url) => {
+            let connection = cache.get(url);
+            if (!connection) {
+                connection = available[created++];
+                if (!connection) {
+                    throw new Error('Unexpected extra native acquisition');
+                }
+                connection.raw.url = url;
+                cache.set(url, connection);
+            }
+            return connection.reply;
+        });
+        first.raw.close.mockImplementationOnce(() => {
+            first.raw.readyState = WebSocketReadyState.CLOSED;
+            return heldClose.promise;
+        });
+        await client.initialize();
+        first.emitOpen();
+        hello(first, 'replaced-account-stream');
+        const sharedUrl = first.raw.url;
+        client.close(true);
+        const oldWait = client.waitForClose();
+        await advanceTimers(500);
+        await oldWait;
+
+        // Model the manager replacing its app client after the bounded wait.
+        const successor = new WebSocketClient(serverUrl, 'successor-qa-token');
+        const received = jest.fn();
+        successor.setEventCallback(received);
+        try {
+            await successor.initialize();
+            expect(cache.get(sharedUrl)).toBe(fresh);
+            expect(first.raw.invalidate).toHaveBeenCalledTimes(1);
+            fresh.emitOpen();
+            hello(fresh, 'successor-stream');
+            fresh.emit({seq: 1, event: 'posted', data: {post_id: 'successor-post'}});
+            heldClose.resolve(undefined);
+            await advanceTimers(0);
+            expect(cache.get(sharedUrl)).toBe(fresh);
+            expect(fresh.raw.invalidate).not.toHaveBeenCalled();
+            expect(successor.isConnected()).toBe(true);
+            expect(successor.getConnectionId()).toBe('successor-stream');
+            expect(successor.getServerSequence()).toBe(2);
+            expect(received.mock.calls.map(([packet]) => packet.seq)).toEqual([0, 1]);
+        } finally {
+            heldClose.resolve(undefined);
+            successor.close(true);
+            successor.invalidate();
+            await advanceTimers(0);
+        }
+    });
+
+    it('keeps one heartbeat interval for the owned stream and ignores an old stream open', async () => {
+        await client.initialize();
+        const baseline = jest.getTimerCount();
+        first.emitOpen();
+        expect(jest.getTimerCount()).toBe(baseline + 1);
+        const staleOpen = first.handlers.open;
+        client.close(true);
+        client.invalidate();
+        const fresh = nativeConnection();
+        useNative(fresh);
+        await client.initialize();
+        fresh.emitOpen();
+        const activeTimers = jest.getTimerCount();
+        const sendsBeforeStaleOpen = fresh.raw.send.mock.calls.length;
+        staleOpen?.({url: first.raw.url, message: {code: 101}});
+        expect(jest.getTimerCount()).toBe(activeTimers);
+        expect(activeTimers).toBe(baseline + 1);
+        expect(fresh.raw.send).toHaveBeenCalledTimes(sendsBeforeStaleOpen);
+        fresh.emit({seq_reply: 2, status: 'OK', data: {text: WebsocketEvents.PONG}});
+        const oldSends = first.raw.send.mock.calls.length;
+        const sends = fresh.raw.send.mock.calls.length;
+        await advanceTimers(30000);
+        expect(first.raw.send).toHaveBeenCalledTimes(oldSends);
+        expect(fresh.raw.send).toHaveBeenCalledTimes(sends + 1);
+        client.close(true);
+        expect(jest.getTimerCount()).toBe(baseline);
+    });
+});
