+if [[ ! -d "$RR_ANDROID_SDK/platforms/android-36" ]]; then
+    echo 'Android SDK platform 36 is required.' >&2
+    exit 1
+fi
+
+# Android-only preparation: do not run the upstream macOS iOS/pod postinstall.
+cd "$RR_SOURCE_ROOT"
+./node_modules/.bin/patch-package
+node scripts/generate-assets.js
+node scripts/generate-compass-glyph-map.mjs
+mkdir -p assets/fonts android/app/src/main/assets/fonts android/app/src/main/res/raw
+cp node_modules/@mattermost/compass-icons/font/compass-icons.ttf assets/fonts/
+cp node_modules/@mattermost/compass-icons/font/compass-icons.ttf android/app/src/main/assets/fonts/
+cp assets/sounds/* android/app/src/main/res/raw/
+
+cd android
+ANDROID_HOME="$RR_ANDROID_SDK" ANDROID_SDK_ROOT="$RR_ANDROID_SDK" \
+    python3 ../scripts/run-read-receipts-gradle.py :app:assembleRelease \
+    -PreadReceiptsQa=true \
+    -PreactNativeArchitectures=arm64-v8a \
+    --max-workers="${RR_GRADLE_WORKERS:-4}" "$@"
