+const Status = () => <Text testID='receipt-occluded'>{String(useReceiptOccluded())}</Text>;
+const call = (channelID: string): IncomingCallNotification => ({channelID, callID: `call-${channelID}`} as IncomingCallNotification);
+
+describe('floating call receipt occlusion', () => {
+    beforeEach(() => {
+        jest.mocked(CurrentCallBar).mockImplementation(() => <View testID='current-call'/>);
+        jest.mocked(JoinCallBanner).mockImplementation(() => <View testID='join-call'/>);
+        jest.mocked(useIncomingCalls).mockReturnValue({...DefaultIncomingCalls, incomingCalls: []});
+    });
+
+    const tree = (props?: ComponentProps<typeof FloatingCallContainer>) => (
+        <ReceiptOcclusionProvider>
+            {props && <FloatingCallContainer {...props}/>}
+            <Status/>
+        </ReceiptOcclusionProvider>
+    );
+
+    it('keeps empty incoming and absent-channel join containers unblocked', () => {
+        jest.mocked(useIncomingCalls).mockReturnValue({...DefaultIncomingCalls, incomingCalls: [call('current-channel')]});
+        const {getByTestId, rerender} = renderWithIntlAndTheme(tree({showIncomingCalls: true, channelId: 'current-channel'}));
+        expect(getByTestId('receipt-occluded')).toHaveTextContent('false');
+        rerender(tree({showJoinCallBanner: true}));
+        expect(getByTestId('receipt-occluded')).toHaveTextContent('false');
+    });
+
+    it('blocks for a real incoming bar and clears the block when it disappears', () => {
+        jest.mocked(useIncomingCalls).mockReturnValue({...DefaultIncomingCalls, incomingCalls: [call('other-channel')]});
