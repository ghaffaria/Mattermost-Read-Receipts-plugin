+import {advanceTimers} from '@test/timer_helpers';
+
+import {createReceiptClient} from './client';
+import {getVisibleReceiptPostIds, mergeVisibleReceiptPostIds, useReadReceiptList} from './hooks';
+import {ReceiptOcclusionProvider, useReceiptOcclusion} from './occlusion';
+
+import type {ReceiptClient} from './types';
+import type PostModel from '@typings/database/models/servers/post';
+import type {AvailableScreens} from '@typings/screens/navigation';
+
+jest.mock('./client', () => ({createReceiptClient: jest.fn()}));
+jest.mock('@hooks/device', () => ({useIsTablet: jest.fn()}));
+jest.mock('@react-navigation/native', () => ({
+    NavigationContext: jest.requireActual('react').createContext(undefined),
+}));
+
+const post = (id: string, channelId = 'channel-one'): PostModel => ({
+    id, channelId, userId: 'sender', deleteAt: 0, type: '',
+} as PostModel);
+
+const tokens = (...posts: PostModel[]): ViewToken[] => posts.map((currentPost) => ({
+    key: currentPost.id,
+    index: 0,
+    isViewable: true,
+    item: {type: 'post', value: {currentPost}},
+}));
+
+const screen = (name: AvailableScreens) => NavigationStore.updateFromNavigationState({
+    key: 'read-receipts-test',
+    type: 'stack',
+    stale: false,
+    index: 0,
+    routeNames: [name],
+    routes: [{key: `${name}-test`, name}],
+});
+
+describe('native receipt visibility and attention', () => {
+    let client: jest.Mocked<ReceiptClient>;
+    let appEvents: Map<AppStateEvent, (state?: string) => void>;
+    let routeEvents: Map<string, () => void>;
+    let initialWindowModule: unknown;
+    let navigation: NonNullable<React.ComponentProps<typeof NavigationContext.Provider>['value']>;
+
+    beforeEach(() => {
+        jest.useFakeTimers({doNotFake: ['nextTick']});
+        jest.replaceProperty(Platform, 'OS', 'android');
+        initialWindowModule = NativeModules.ReadReceiptsWindow;
+        NativeModules.ReadReceiptsWindow = {hasWindowFocus: jest.fn().mockResolvedValue(true)};
+        jest.mocked(useIsTablet).mockReturnValue(false);
+        NavigationStore.reset();
+        screen(Screens.CHANNEL);
+        appEvents = new Map();
+        routeEvents = new Map();
+        jest.mocked(AppState.addEventListener).mockImplementation((event, callback) => {
+            appEvents.set(event, callback as (state?: string) => void);
+            return {remove: () => appEvents.delete(event)};
+        });
+        navigation = {
+            isFocused: () => true,
+            addListener: (event: string, callback: () => void) => {
+                routeEvents.set(event, callback);
+                return () => routeEvents.delete(event);
+            },
+        } as unknown as typeof navigation;
+        client = {
+            getConfig: jest.fn().mockResolvedValue({enable: true, visibility_threshold_ms: 2000}),
+            getReceipts: jest.fn().mockResolvedValue([]),
+            markRead: jest.fn().mockResolvedValue({}),
+        };
+        jest.mocked(createReceiptClient).mockReturnValue(client);
+    });
+
+    afterEach(() => {
+        jest.useRealTimers();
+        jest.restoreAllMocks();
+        NativeModules.ReadReceiptsWindow = initialWindowModule;
+        NavigationStore.reset();
+    });
+
+    const Wrapper = ({children}: PropsWithChildren) => (
+        <NavigationContext.Provider value={navigation}>
+            <ReceiptOcclusionProvider>
+                {children}
+            </ReceiptOcclusionProvider>
+        </NavigationContext.Provider>
+    );
+    const props = (posts: PostModel[]) => ({
+        serverUrl: 'https://local-receipt-qa.invalid',
+        userId: 'reader',
+        channelId: 'channel-one',
+        location: Screens.CHANNEL,
+        posts,
+    });
+    const elapse = async (ms: number) => act(async () => advanceTimers(ms));
+
+    it('ignores preloaded/date rows and marks only the actual native viewport', async () => {
+        const shown = post('visible');
+        const preloaded = post('preloaded');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([shown, preloaded]), wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(shown), changed: []}));
+        await elapse(0);
+        await elapse(2250);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        expect(client.markRead).toHaveBeenCalledWith(expect.objectContaining({id: shown.id, channelId: shown.channelId}));
+        unmount();
+        expect(appEvents.size).toBe(0);
+        expect(routeEvents.size).toBe(0);
+    });
+
+    it('unions short-item and tall-post viewport thresholds and removes stale exits', async () => {
+        const short = post('short');
+        const tall = post('tall');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([short, tall]), wrapper: Wrapper});
+        act(() => {
+            result.current.onItemViewableItemsChanged({viewableItems: tokens(short), changed: []});
+            result.current.onAreaViewableItemsChanged({viewableItems: tokens(short, tall), changed: []});
+        });
+        await elapse(0);
+        await elapse(1000);
+        act(() => {
+            result.current.onItemViewableItemsChanged({viewableItems: [], changed: []});
+            result.current.onAreaViewableItemsChanged({viewableItems: tokens(tall), changed: []});
+        });
+        await elapse(1500);
+        expect(client.markRead.mock.calls.map(([value]) => value.id)).toEqual(['tall']);
+        unmount();
+    });
+
+    it('pauses for an in-screen overlay and requires a full fresh dwell after it closes', async () => {
+        const incoming = post('covered');
+        const {result, rerender, unmount} = renderHook(({blocked, ...listProps}: ReturnType<typeof props> & {blocked: boolean}) => {
+            useReceiptOcclusion(blocked);
+            return useReadReceiptList(listProps);
+        }, {initialProps: {...props([incoming]), blocked: false}, wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []}));
+        await elapse(0);
+        await elapse(1500);
+        rerender({...props([incoming]), blocked: true});
+        await elapse(0);
+        await elapse(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        rerender({...props([incoming]), blocked: false});
+        await elapse(0);
+        await elapse(1750);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await elapse(500);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('fails closed when mounted beneath an already open notification shade and waits a fresh dwell after focus', async () => {
+        NativeModules.ReadReceiptsWindow.hasWindowFocus.mockResolvedValue(false);
+        const incoming = post('cold-shade');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([incoming]), wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []}));
+        await elapse(0);
+        await elapse(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        act(() => appEvents.get('focus')?.());
+        await elapse(1750);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await elapse(500);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('ignores a stale positive focus snapshot if a newer blur event arrived', async () => {
+        let resolveProbe: (value: boolean) => void = () => undefined;
+        NativeModules.ReadReceiptsWindow.hasWindowFocus.mockReturnValue(new Promise<boolean>((resolve) => {
+            resolveProbe = resolve;
+        }));
+        const incoming = post('stale-probe');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([incoming]), wrapper: Wrapper});
+        act(() => {
+            result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []});
+            appEvents.get('blur')?.();
+            resolveProbe(true);
+        });
+        await elapse(0);
+        await elapse(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        act(() => appEvents.get('focus')?.());
+        await elapse(2250);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('fails closed when the native focus snapshot is unavailable', async () => {
+        NativeModules.ReadReceiptsWindow.hasWindowFocus.mockRejectedValue(new Error('Native focus unavailable'));
+        const incoming = post('unknown-focus');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([incoming]), wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []}));
+        await elapse(0);
+        await elapse(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        unmount();
+    });
+
+    it('preserves non-Android foreground behavior without requiring the Android native probe', async () => {
+        jest.replaceProperty(Platform, 'OS', 'ios');
+        jest.replaceProperty(AppState, 'currentState', 'background');
+        const incoming = post('ios-foreground');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([incoming]), wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []}));
+        await elapse(0);
+        await elapse(3000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        act(() => appEvents.get('change')?.('active'));
+        await elapse(2250);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        expect(NativeModules.ReadReceiptsWindow.hasWindowFocus).not.toHaveBeenCalled();
+        unmount();
+    });
+
+    it.each(['blur', 'background', 'overlay', 'route'] as const)('resets dwell on %s and resumes without a new scroll callback', async (loss) => {
+        const incoming = post('incoming');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([incoming]), wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []}));
+        await elapse(0);
+        await elapse(1500);
+        act(() => {
+            if (loss === 'blur') {
+                appEvents.get('blur')?.();
+            } else if (loss === 'background') {
+                appEvents.get('change')?.('background');
+            } else if (loss === 'overlay') {
+                screen(Screens.GENERIC_BOTTOM_SHEET);
+            } else {
+                routeEvents.get('blur')?.();
+            }
+        });
+        await elapse(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        act(() => {
+            if (loss === 'blur') {
+                appEvents.get('focus')?.();
+            } else if (loss === 'background') {
+                appEvents.get('change')?.('active');
+            } else if (loss === 'overlay') {
+                screen(Screens.CHANNEL);
+            } else {
+                routeEvents.get('focus')?.();
+            }
+        });
+        await elapse(0);
+        await elapse(1750);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await elapse(500);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('clears both visible sources and disposes clocks when account/channel scope changes', async () => {
+        const startClock = jest.spyOn(global, 'setInterval');
+        const stopClock = jest.spyOn(global, 'clearInterval');
+        const oldPost = post('old');
+        const newPost = post('new', 'channel-two');
+        const initialProps = props([oldPost]);
+        const {result, rerender, unmount} = renderHook(useReadReceiptList, {initialProps, wrapper: Wrapper});
+        act(() => result.current.onAreaViewableItemsChanged({viewableItems: tokens(oldPost), changed: []}));
+        await elapse(0);
+        await elapse(1000);
+        rerender({...initialProps, channelId: 'channel-two', userId: 'other-reader', posts: [newPost]});
+        await elapse(0);
+        await elapse(3000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(newPost), changed: []}));
+        await elapse(2250);
+        expect(client.markRead).toHaveBeenCalledWith(expect.objectContaining({id: 'new', channelId: 'channel-two'}));
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        unmount();
+        expect(startClock).toHaveBeenCalledTimes(2);
+        for (const started of startClock.mock.results) {
+            expect(stopClock).toHaveBeenCalledWith(started.value);
+        }
+    });
+
+    it('requires the visible tablet channel pane rather than a hidden channel behind a thread', async () => {
+        jest.mocked(useIsTablet).mockReturnValue(true);
+        screen(Screens.CHANNEL_LIST);
+        const incoming = post('tablet-post');
+        const {result, unmount} = renderHook(useReadReceiptList, {initialProps: props([incoming]), wrapper: Wrapper});
+        act(() => result.current.onItemViewableItemsChanged({viewableItems: tokens(incoming), changed: []}));
+        await elapse(0);
+        await elapse(1000);
+        act(() => screen(Screens.THREAD));
+        await elapse(3000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        act(() => screen(Screens.CHANNEL_LIST));
+        await elapse(0);
+        await elapse(2250);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        unmount();
+    });
+
+    it('extracts only viewable post rows and deduplicates the two threshold sources', () => {
+        const shown = tokens(post('shown'));
+        const hidden = {...tokens(post('hidden'))[0], isViewable: false};
+        const date = {...shown[0], item: {type: 'date', value: 'today'}};
+        expect(getVisibleReceiptPostIds([...shown, hidden, date])).toEqual(['shown']);
+        expect(mergeVisibleReceiptPostIds({item: ['short', 'same'], area: ['same', 'tall']})).toEqual(['short', 'same', 'tall']);
+    });
+});
