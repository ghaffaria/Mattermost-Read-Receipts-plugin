+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {createContext, useCallback, useContext, useSyncExternalStore} from 'react';
+
+import type {ReadReceiptController} from './controller';
+import type {Receipt} from './types';
+
+const EMPTY_READERS: readonly Receipt[] = [];
+const subscribeToNothing = () => () => undefined;
+
+const ReadReceiptContext = createContext<ReadReceiptController | undefined>(undefined);
+
+export const ReadReceiptProvider = ReadReceiptContext.Provider;
+
+export const useReadReceiptReaders = (postId: string): readonly Receipt[] => {
+    const controller = useContext(ReadReceiptContext);
+    const subscribe = useCallback((listener: () => void) => (
+        controller ? controller.subscribe(listener) : subscribeToNothing()
+    ), [controller]);
+    const getSnapshot = useCallback(() => controller?.getReaders(postId) || EMPTY_READERS, [controller, postId]);
+
+    // Cached per-post snapshots let receipt polling update only affected indicators.
+    return useSyncExternalStore(subscribe, getSnapshot, getSnapshot);
+};
