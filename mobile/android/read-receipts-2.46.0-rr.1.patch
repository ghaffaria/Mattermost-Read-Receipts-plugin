+#!/usr/bin/env python3
+"""Run Gradle with an explicitly supplied, private QA signing configuration."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+config_path = os.environ.get('RR_QA_SIGNING_CONFIG')
+if not config_path:
+    raise SystemExit('Set RR_QA_SIGNING_CONFIG to a private JSON file with store_file, store_password and key_alias.')
+config_file = Path(config_path)
+if config_file.stat().st_mode & 0o077:
+    raise SystemExit('The QA signing configuration must be private (chmod 600).')
+config = json.loads(config_file.read_text())
+if not Path(config['store_file']).is_file():
+    raise SystemExit('The QA signing keystore was not found.')
+env = os.environ.copy()
+for property_name, value in {
+    'MATTERMOST_RELEASE_STORE_FILE': config['store_file'],
+    'MATTERMOST_RELEASE_PASSWORD': config['store_password'],
+    'MATTERMOST_RELEASE_KEY_ALIAS': config['key_alias'],
+}.items():
+    env['ORG_GRADLE_PROJECT_' + property_name] = value
+android_dir = Path(__file__).resolve().parent.parent / 'android'
+raise SystemExit(subprocess.run(['./gradlew', *sys.argv[1:]], cwd=android_dir, env=env).returncode)
diff --git a/scripts/test-read-receipts-network-client.cjs b/scripts/test-read-receipts-network-client.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..d2f9219361640399e2a820ed000ae575d0397eb3
--- /dev/null
+++ b/scripts/test-read-receipts-network-client.cjs
@@ -0,0 +1,447 @@
+// Exercise the installed SDK factory, stubbing only the native transport boundary.
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const {test} = require('node:test');
+const vm = require('node:vm');
+const {transformSync} = require('@babel/core');
+
+const sdkRoot = path.dirname(require.resolve('@mattermost/react-native-network-client/package.json'));
+const sdkEntries = {
+    source: 'src/WebSocketClient/index.tsx',
+    commonjs: 'lib/commonjs/WebSocketClient/index.js',
+    module: 'lib/module/WebSocketClient/index.js',
+};
+const compiledEntries = Object.fromEntries(Object.entries(sdkEntries).map(([name, entry]) => {
+    const source = fs.readFileSync(path.join(sdkRoot, entry), 'utf8');
+    const compiled = name === 'commonjs' ? source : transformSync(source, {
+        filename: entry,
+        configFile: false,
+        babelrc: false,
+        presets: [['@babel/preset-typescript', {allExtensions: true, isTSX: true}]],
+        plugins: ['@babel/plugin-transform-modules-commonjs'],
+    }).code;
+    return [name, compiled];
+}));
+
+function factory({
+    entry = 'source',
+    os = 'android',
+    connectFor = async () => undefined,
+    ensureClientFor = async () => undefined,
+    invalidateClientFor = async () => undefined,
+} = {}) {
+    const calls = [];
+    const connectCalls = [];
+    const disconnectCalls = [];
+    const invalidateCalls = [];
+    const listeners = new Map();
+    const states = {CONNECTING: 0, OPEN: 1, CLOSING: 2, CLOSED: 3};
+    const events = {READY_STATE_EVENT: 'state', OPEN_EVENT: 'open', CLOSE_EVENT: 'close', ERROR_EVENT: 'error', MESSAGE_EVENT: 'message'};
+    const native = {
+        ensureClientFor: (url, config) => {
+            calls.push({url, config});
+            return ensureClientFor(url, config);
+        },
+        invalidateClientFor: (url) => {
+            invalidateCalls.push(url);
+            return invalidateClientFor(url);
+        },
+        disconnectFor: async (url) => { disconnectCalls.push(url); },
+        connectFor: (url) => {
+            connectCalls.push(url);
+            return connectFor(url);
+        },
+    };
+    const module = {exports: {}};
+    vm.runInNewContext(compiledEntries[entry], {
+        module,
+        exports: module.exports,
+        require: (name) => {
+            if (name === 'react-native') {
+                return {Platform: {OS: os}, NativeEventEmitter: class {
+                    addListener(event, callback) {
+                        if (!listeners.has(event)) {
+                            listeners.set(event, new Set());
+                        }
+                        listeners.get(event).add(callback);
+                        return {remove() { listeners.get(event).delete(callback); }};
+                    }
+                }};
+            }
+            if (name === 'validator/es/lib/isURL') {
+                return require('validator/lib/isURL');
+            }
+            if (name === './NativeWebSocketClient') {
+                return {__esModule: true, default: native, WebSocketReadyState: states, WebSocketEvents: events};
+            }
+            throw new Error(`Unexpected SDK dependency: ${name}`);
+        },
+    });
+    return {
+        get: module.exports.getOrCreateWebSocketClient,
+        calls,
+        connectCalls,
+        disconnectCalls,
+        invalidateCalls,
+        states,
+        events,
+        listenerCount() {
+            return [...listeners.values()].reduce((count, callbacks) => count + callbacks.size, 0);
+        },
+        emitReadyState(url, state) {
+            const current = calls.filter((call) => call.url === url).at(-1);
+            for (const callback of [...(listeners.get('state') || [])]) {
+                callback({url, message: state, eventGeneration: current?.config.eventGeneration});
+            }
+        },
+        emit(event, data) {
+            for (const callback of [...(listeners.get(event) || [])]) {
+                callback(data);
+            }
+        },
+    };
+}
+
+for (const url of [
+    'ws://localhost:19065/api/v4/websocket',
+    'wss://localhost:19065/api/v4/websocket?connection_id=qa&sequence_number=1',
+    'ws://mattermost:8065/api/v4/websocket',
+    'wss://mattermost.internal/api/v4/websocket',
+    'wss://chat.example.com/api/v4/websocket',
+    'ws://127.0.0.1:19065/api/v4/websocket',
+    'ws://[::1]:19065/api/v4/websocket',
+]) {
+    test(`SDK opens valid WebSocket endpoint ${url}`, async () => {
+        const {get, calls} = factory();
+        const config = {headers: {origin: 'http://localhost:19065'}, timeoutInterval: 30000};
+        const first = await get(url, config);
+        assert.equal(first.created, true);
+        assert.equal(calls.length, 1);
+        assert.equal(calls[0].url, url);
+        assert.equal(calls[0].config.headers, config.headers);
+        assert.equal(calls[0].config.timeoutInterval, config.timeoutInterval);
+        const second = await get(url, config);
+        assert.equal(second.client, first.client);
+        assert.equal(second.created, false);
+        assert.equal(calls.length, 1);
+    });
+}
+
+function deferred() {
+    let resolve;
+    let reject;
+    const promise = new Promise((resolvePromise, rejectPromise) => {
+        resolve = resolvePromise;
+        reject = rejectPromise;
+    });
+    return {promise, resolve, reject};
+}
+
+for (const entry of Object.keys(sdkEntries)) {
+    const url = 'ws://localhost:19065/api/v4/websocket';
+
+    test(entry + ' SDK opens one native socket throughout a pending handshake', async () => {
+        const nativeConnect = deferred();
+        const transport = factory({entry, connectFor: () => nativeConnect.promise});
+        const {client} = await transport.get(url);
+        const firstOpen = client.open();
+        assert.equal(client.readyState, transport.states.CONNECTING);
+        await client.open();
+        assert.equal(transport.connectCalls.length, 1);
+
+        // Native connectFor acknowledges before OkHttp onOpen: this remains a handshake.
+        nativeConnect.resolve();
+        await firstOpen;
+        assert.equal(client.readyState, transport.states.CONNECTING);
+        await client.open();
+        assert.equal(transport.connectCalls.length, 1);
+    });
+
+    test(entry + ' SDK does not reopen an OPEN native socket', async () => {
+        const transport = factory({entry});
+        const {client} = await transport.get(url);
+        await client.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        await client.open();
+        assert.equal(client.readyState, transport.states.OPEN);
+        assert.equal(transport.connectCalls.length, 1);
+    });
+
+    test(entry + ' SDK permits retry after the current native open rejects', async () => {
+        const nativeConnect = deferred();
+        let attempt = 0;
+        const transport = factory({entry, connectFor: () => attempt++ === 0 ? nativeConnect.promise : Promise.resolve()});
+        const {client} = await transport.get(url);
+        const opening = client.open();
+        const failure = new Error('Native connect rejected');
+        nativeConnect.reject(failure);
+        await assert.rejects(opening, (error) => error === failure);
+        assert.equal(client.readyState, transport.states.CLOSED);
+
+        await client.open();
+        assert.equal(client.readyState, transport.states.CONNECTING);
+        assert.equal(transport.connectCalls.length, 2);
+    });
+
+    test(entry + ' SDK ignores a rejected earlier open after close and reopen', async () => {
+        const earlier = deferred();
+        const current = deferred();
+        let attempt = 0;
+        const transport = factory({entry, connectFor: () => attempt++ === 0 ? earlier.promise : current.promise});
+        const {client} = await transport.get(url);
+        const earlierOpen = client.open();
+        await client.close();
+        const currentOpen = client.open();
+        const failure = new Error('Earlier native connect rejected late');
+        earlier.reject(failure);
+        await assert.rejects(earlierOpen, (error) => error === failure);
+        assert.equal(client.readyState, transport.states.CONNECTING);
+        await client.open();
+        assert.equal(transport.connectCalls.length, 2);
+        current.resolve();
+        await currentOpen;
+    });
+
+    test(entry + ' SDK does not regress OPEN when its native acknowledgement rejects late', async () => {
+        const nativeConnect = deferred();
+        const transport = factory({entry, connectFor: () => nativeConnect.promise});
+        const {client} = await transport.get(url);
+        const opening = client.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        const failure = new Error('Late native acknowledgement rejected');
+        nativeConnect.reject(failure);
+        await assert.rejects(opening, (error) => error === failure);
+        assert.equal(client.readyState, transport.states.OPEN);
+        await client.open();
+        assert.equal(transport.connectCalls.length, 1);
+    });
+
+    for (const cleanupRejects of [false, true]) {
+        test(entry + ' SDK recovers a rejected factory with cleanup ' + (cleanupRejects ? 'rejection' : 'success'), async () => {
+            const initialEnsure = deferred();
+            const originalError = new Error('Native ensure rejected');
+            const cleanupError = new Error('Cleanup also rejected');
+            let attempt = 0;
+            const transport = factory({
+                entry,
+                ensureClientFor: () => attempt++ === 0 ? initialEnsure.promise : Promise.resolve(),
+                invalidateClientFor: async () => {
+                    if (cleanupRejects) {
+                        throw cleanupError;
+                    }
+                },
+            });
+            const first = transport.get(url, {}, () => {});
+            assert.equal(transport.listenerCount(), 2);
+            await assert.rejects(transport.get(url), /Already creating a client/);
+            initialEnsure.reject(originalError);
+            await assert.rejects(first, (error) => error === originalError);
+
+            const retry = await transport.get(url);
+            assert.equal(retry.created, true);
+            assert.equal(transport.calls.length, 2);
+            assert.equal(transport.invalidateCalls.length, 1);
+            assert.equal(transport.listenerCount(), 1);
+            const shared = await transport.get(url);
+            assert.equal(shared.client, retry.client);
+            assert.equal(shared.created, false);
+            assert.equal(transport.calls.length, 2);
+            assert.equal(transport.invalidateCalls.length, 1);
+        });
+    }
+
+    test(entry + ' SDK repeated old invalidation preserves a replacement wrapper', async () => {
+        const nativeRetirement = deferred();
+        const transport = factory({entry, invalidateClientFor: () => nativeRetirement.promise});
+        const {client: oldClient} = await transport.get(url);
+        const retiring = oldClient.invalidate();
+        assert.equal(transport.listenerCount(), 0);
+        const {client: replacement} = await transport.get(url);
+        assert.notEqual(replacement, oldClient);
+        const repeatedRetirement = oldClient.invalidate();
+        assert.equal(transport.invalidateCalls.length, 1);
+        assert.equal(transport.listenerCount(), 1);
+        await replacement.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        assert.equal(replacement.readyState, transport.states.OPEN);
+        const shared = await transport.get(url);
+        assert.equal(shared.client, replacement);
+        assert.equal(shared.created, false);
+        nativeRetirement.resolve();
+        await Promise.all([retiring, repeatedRetirement]);
+        assert.equal(transport.invalidateCalls.length, 1);
+    });
+
+    test(entry + ' SDK rejects open through a retired reference', async () => {
+        const transport = factory({entry});
+        const {client: oldClient} = await transport.get(url);
+        await oldClient.invalidate();
+        const {client: replacement} = await transport.get(url);
+        await replacement.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        await assert.rejects(oldClient.open(), /invalidated|retired/);
+        assert.equal(transport.connectCalls.length, 1);
+        assert.equal(replacement.readyState, transport.states.OPEN);
+        assert.equal((await transport.get(url)).client, replacement);
+    });
+
+    test(entry + ' SDK ignores close through a retired reference', async () => {
+        const transport = factory({entry});
+        const {client: oldClient} = await transport.get(url);
+        await oldClient.invalidate();
+        const {client: replacement} = await transport.get(url);
+        await replacement.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        await oldClient.close();
+        assert.equal(transport.disconnectCalls.length, 0);
+        assert.equal(transport.invalidateCalls.length, 1);
+        assert.equal(replacement.readyState, transport.states.OPEN);
+        assert.equal((await transport.get(url)).client, replacement);
+    });
+
+    test(entry + ' Android SDK rejects every delayed event from a replaced generation', async () => {
+        const transport = factory({entry});
+        const {client: oldClient} = await transport.get(url);
+        const oldGeneration = transport.calls.at(-1).config.eventGeneration || 'old-generation';
+        await oldClient.invalidate();
+        const {client: replacement} = await transport.get(url);
+        const generation = transport.calls.at(-1).config.eventGeneration;
+        const counts = {open: 0, message: 0, close: 0, error: 0, clientError: 0};
+        replacement.onOpen(() => counts.open++);
+        replacement.onMessage(() => counts.message++);
+        replacement.onClose(() => counts.close++);
+        replacement.onError(() => counts.error++);
+        replacement.onClientError(() => counts.clientError++);
+        await replacement.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        transport.emit('state', {url, message: transport.states.CLOSED, eventGeneration: oldGeneration});
+        assert.equal(replacement.readyState, transport.states.OPEN);
+        for (const event of ['open', 'message', 'close', 'error']) {
+            transport.emit(event, {url, message: {event: 'hello'}, eventGeneration: oldGeneration});
+            transport.emit(event, {url, message: {event: 'hello'}});
+        }
+        assert.deepEqual(counts, {open: 0, message: 0, close: 0, error: 0, clientError: 0});
+        assert.equal(typeof generation, 'string');
+        assert.notEqual(generation, oldGeneration);
+        for (const event of ['open', 'message', 'close', 'error']) {
+            transport.emit(event, {url, message: {}, eventGeneration: generation});
+        }
+        assert.deepEqual(counts, {open: 1, message: 1, close: 1, error: 1, clientError: 1});
+    });
+
+    test(entry + ' Android SDK rotates generation before same-wrapper physical reopen', async () => {
+        const transport = factory({entry});
+        const config = {headers: {origin: 'http://localhost:19065'}, timeoutInterval: 30000};
+        const {client} = await transport.get(url, config);
+        const oldGeneration = transport.calls.at(-1).config.eventGeneration || 'old-generation';
+        let messages = 0;
+        let closes = 0;
+        client.onMessage(() => messages++);
+        client.onClose(() => closes++);
+        await client.open();
+        transport.emitReadyState(url, transport.states.OPEN);
+        await client.close();
+        transport.emit('state', {url, message: transport.states.OPEN, eventGeneration: oldGeneration});
+        transport.emit('message', {url, message: {event: 'hello'}, eventGeneration: oldGeneration});
+        assert.equal(client.readyState, transport.states.CLOSED);
+        assert.equal(messages, 0);
+        await client.open();
+        const generation = transport.calls.at(-1).config.eventGeneration;
+        transport.emitReadyState(url, transport.states.OPEN);
+        transport.emit('state', {url, message: transport.states.CLOSED, eventGeneration: oldGeneration});
+        transport.emit('message', {url, message: {event: 'hello'}, eventGeneration: oldGeneration});
+        transport.emit('close', {url, message: {}, eventGeneration: oldGeneration});
+        assert.equal(client.readyState, transport.states.OPEN);
+        assert.equal(messages, 0);
+        assert.equal(closes, 0);
+        assert.equal(typeof generation, 'string');
+        assert.notEqual(generation, oldGeneration);
+        assert.equal(transport.calls.length, 2);
+        assert.equal(transport.calls[1].config.headers, config.headers);
+        assert.equal(transport.calls[1].config.timeoutInterval, config.timeoutInterval);
+        transport.emit('message', {url, message: {}, eventGeneration: generation});
+        assert.equal(messages, 1);
+    });
+
+    test(entry + ' Android SDK generation does not reset between JavaScript runtimes', async () => {
+        const first = factory({entry});
+        const second = factory({entry});
+        await first.get(url);
+        await second.get(url);
+        const one = first.calls[0].config.eventGeneration;
+        const two = second.calls[0].config.eventGeneration;
+        assert.equal(typeof one, 'string');
+        assert.equal(typeof two, 'string');
+        assert.notEqual(one, two);
+    });
+
+    for (const action of ['close', 'invalidate']) {
+        test(entry + ' Android SDK cancels deferred reopen ensure on ' + action, async () => {
+            const refresh = deferred();
+            let ensureAttempt = 0;
+            const transport = factory({
+                entry,
+                ensureClientFor: () => ensureAttempt++ === 1 ? refresh.promise : Promise.resolve(),
+            });
+            const {client} = await transport.get(url);
+            await client.open();
+            await client.close();
+            const pendingOpen = client.open();
+            assert.equal(transport.calls.length, 2);
+            assert.equal(transport.connectCalls.length, 1);
+            await client[action]();
+            let replacement;
+            if (action === 'invalidate') {
+                replacement = (await transport.get(url)).client;
+                await replacement.open();
+                transport.emitReadyState(url, transport.states.OPEN);
+            }
+            refresh.resolve();
+            await pendingOpen;
+            assert.equal(transport.connectCalls.length, action === 'close' ? 1 : 2);
+            if (replacement) {
+                assert.equal(replacement.readyState, transport.states.OPEN);
+                assert.equal((await transport.get(url)).client, replacement);
+                assert.equal(transport.invalidateCalls.length, 1);
+            } else {
+                assert.equal(client.readyState, transport.states.CLOSED);
+                await client.open();
+                assert.equal(transport.connectCalls.length, 2);
+            }
+        });
+    }
+
+    test(entry + ' iOS SDK retains untagged event and reopen behavior', async () => {
+        const transport = factory({entry, os: 'ios'});
+        const config = {headers: {origin: 'https://chat.example.com'}};
+        const {client} = await transport.get(url, config);
+        let messages = 0;
+        client.onMessage(() => messages++);
+        await client.open();
+        transport.emit('state', {url, message: transport.states.OPEN});
+        transport.emit('message', {url, message: {event: 'hello'}});
+        assert.equal(client.readyState, transport.states.OPEN);
+        assert.equal(messages, 1);
+        assert.equal(transport.calls[0].config, config);
+        await client.close();
+        await client.open();
+        assert.equal(transport.calls.length, 1);
+        assert.equal(transport.connectCalls.length, 2);
+    });
+}
+
+for (const url of [
+    'https://localhost:19065/api/v4/websocket',
+    'ftp://chat.example.com/api/v4/websocket',
+    'localhost:19065/api/v4/websocket',
+    'ws:///api/v4/websocket',
+    'ws://bad host/api/v4/websocket',
+    'ws://localhost:99999/api/v4/websocket',
+]) {
+    test(`SDK rejects malformed/unsupported endpoint ${url}`, async () => {
+        const {get, calls} = factory();
+        await assert.rejects(get(url), /not a valid WebSocket URL/);
+        assert.equal(calls.length, 0);
+    });
+}
