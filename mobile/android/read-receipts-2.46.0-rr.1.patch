@@ -0,0 +1,63 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React, {createContext, type PropsWithChildren, useContext, useLayoutEffect, useState, useSyncExternalStore} from 'react';
+
+const createOcclusionStore = () => {
+    const blockers = new Set<symbol>();
+    const listeners = new Set<() => void>();
+    const getSnapshot = () => blockers.size > 0;
+    const subscribe = (listener: () => void) => {
+        listeners.add(listener);
+        return () => listeners.delete(listener);
+    };
+    const setBlocked = (key: symbol, blocked: boolean) => {
+        const previous = getSnapshot();
+        if (blocked) {
+            blockers.add(key);
+        } else {
+            blockers.delete(key);
+        }
+        if (previous !== getSnapshot()) {
+            listeners.forEach((listener) => listener());
+        }
+    };
+    const clear = () => {
+        blockers.clear();
+        listeners.clear();
+    };
+    return {getSnapshot, subscribe, setBlocked, clear};
+};
+
+const ReceiptOcclusionContext = createContext<ReturnType<typeof createOcclusionStore> | undefined>(undefined);
+const getUnblocked = () => false;
+const subscribeToNothing = () => () => undefined;
+
+export const ReceiptOcclusionProvider = ({children}: PropsWithChildren) => {
+    const [store] = useState(createOcclusionStore);
+    useLayoutEffect(() => () => store.clear(), [store]);
+
+    return (
+        <ReceiptOcclusionContext.Provider value={store}>
+            {children}
+        </ReceiptOcclusionContext.Provider>
+    );
+};
+
+/** Conservative policy: pause this screen's list while any message overlay is open. */
+export const useReceiptOccluded = () => {
+    const store = useContext(ReceiptOcclusionContext);
+    return useSyncExternalStore(store?.subscribe || subscribeToNothing, store?.getSnapshot || getUnblocked, getUnblocked);
+};
+
+export const useReceiptOcclusion = (blocked: boolean) => {
+    const store = useContext(ReceiptOcclusionContext);
+    const [key] = useState(() => Symbol('read-receipt-overlay'));
+    useLayoutEffect(() => {
+        if (!blocked || !store) {
+            return undefined;
+        }
+        store.setBlocked(key, true);
+        return () => store.setBlocked(key, false);
+    }, [blocked, key, store]);
+};
