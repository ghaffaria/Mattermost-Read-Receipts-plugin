+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import NetworkManager from '@managers/network_manager';
+
+import type {ReceiptClient} from './types';
+
+export const createReceiptClient = (serverUrl: string): ReceiptClient => ({
+
+    // Resolve the client for every request, so a removed session is not retained.
+    getConfig: () => NetworkManager.getClient(serverUrl).rrGetConfig(),
+    getReceipts: (channelId, postIds) => NetworkManager.getClient(serverUrl).rrGetReceipts(channelId, postIds),
+    markRead: (post) => NetworkManager.getClient(serverUrl).rrMarkRead(post),
+});
