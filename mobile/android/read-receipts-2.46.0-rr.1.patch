@@ -0,0 +1,67 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {Receipt, ReceiptConfig, ReceiptPost} from '../types';
+import type ClientBase from '@client/rest/base';
+
+const ROUTE = '/plugins/mattermost-readreceipts/api/v1';
+const MAX_POST_IDS = 200;
+const REQUEST_TIMEOUT_MS = 10000;
+
+function isReceipt(value: unknown): value is Receipt {
+    return Boolean(value && typeof value === 'object' &&
+        'MessageID' in value && typeof value.MessageID === 'string' &&
+        'UserID' in value && typeof value.UserID === 'string' &&
+        'ChannelID' in value && typeof value.ChannelID === 'string' &&
+        'Timestamp' in value && typeof value.Timestamp === 'number' && Number.isFinite(value.Timestamp));
+}
+
+export interface ClientReadReceiptsMix {
+    rrGetConfig: () => Promise<ReceiptConfig>;
+    rrGetReceipts: (channelId: string, postIds: string[]) => Promise<Receipt[]>;
+    rrMarkRead: (post: ReceiptPost) => Promise<unknown>;
+}
+
+// Product REST methods use the existing authenticated Mattermost client.
+const ClientReadReceipts = (superclass: typeof ClientBase) => class extends superclass {
+    rrGetConfig = async (): Promise<ReceiptConfig> => {
+        const response: unknown = await this.doFetch(`${ROUTE}/config`, {method: 'get', noRetry: true, timeoutInterval: REQUEST_TIMEOUT_MS});
+        if (!response || typeof response !== 'object' ||
+            !('enable' in response) || typeof response.enable !== 'boolean' ||
+            !('visibility_threshold_ms' in response) || typeof response.visibility_threshold_ms !== 'number') {
+            throw new Error('Invalid read receipt configuration');
+        }
+        return {enable: response.enable, visibility_threshold_ms: response.visibility_threshold_ms};
+    };
+
+    rrGetReceipts = async (channelId: string, postIds: string[]): Promise<Receipt[]> => {
+        if (!postIds.length) {
+            return [];
+        }
+        if (postIds.length > MAX_POST_IDS) {
+            throw new Error('Read receipt requests support at most 200 posts');
+        }
+        const ids = postIds.map(encodeURIComponent).join(',');
+        const response: unknown = await this.doFetch(
+            `${ROUTE}/receipts?channel_id=${encodeURIComponent(channelId)}&post_ids=${ids}`,
+            {method: 'get', noRetry: true, timeoutInterval: REQUEST_TIMEOUT_MS},
+        );
+        if (!Array.isArray(response) || !response.every(isReceipt)) {
+            throw new Error('Invalid read receipt history');
+        }
+        return response;
+    };
+
+    rrMarkRead = async (post: ReceiptPost): Promise<unknown> => {
+        return this.doFetch(`${ROUTE}/read`, {
+            method: 'post',
+            body: {message_id: post.id, channel_id: post.channelId},
+
+            // Retry only through the controller after a fresh visible interval.
+            noRetry: true,
+            timeoutInterval: REQUEST_TIMEOUT_MS,
+        });
+    };
+};
+
+export default ClientReadReceipts;
