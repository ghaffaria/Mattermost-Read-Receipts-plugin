+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {fetchMissingProfilesByIds} from '@actions/remote/user';
+import {usePostConfig} from '@context/post_config';
+import DatabaseManager from '@database/manager';
+import {act, renderWithEverything, renderWithIntlAndTheme, waitFor} from '@test/intl-test-helper';
+import TestHelper from '@test/test_helper';
+
+import {ReadReceiptProvider} from './context';
+import ReadReceiptIndicator from './indicator';
+
+import type {ReadReceiptController} from './controller';
+import type {Receipt} from './types';
+
+jest.mock('@actions/remote/user', () => ({fetchMissingProfilesByIds: jest.fn().mockResolvedValue({})}));
+jest.mock('@context/post_config', () => ({usePostConfig: jest.fn()}));
+
+const serverUrl = 'https://receipt-indicator-qa.invalid';
+const receipt = (postId: string, userId: string): Receipt => ({
+    MessageID: postId,
+    ChannelID: 'local-channel',
+    UserID: userId,
+    Timestamp: 1,
+});
+
+describe('native read receipt indicators', () => {
+    let snapshots: Map<string, readonly Receipt[]>;
+    let listeners: Set<() => void>;
+    let controller: ReadReceiptController;
+    const empty: readonly Receipt[] = [];
+
+    beforeEach(async () => {
+        jest.clearAllMocks();
+        await DatabaseManager.init([serverUrl]);
+        snapshots = new Map();
+        listeners = new Set();
+        controller = {
+            getReaders: (postId: string) => snapshots.get(postId) || empty,
+            subscribe: (listener: () => void) => {
+                listeners.add(listener);
+                return () => listeners.delete(listener);
+            },
+        } as unknown as ReadReceiptController;
+        jest.mocked(usePostConfig).mockReturnValue({teammateNameDisplay: 'username'} as ReturnType<typeof usePostConfig>);
+    });
+
+    afterEach(async () => {
+        await DatabaseManager.destroyServerDatabase(serverUrl);
+    });
+
+    it('silently renders the standard app without an available plugin context', () => {
+        const {queryByTestId} = renderWithIntlAndTheme(<ReadReceiptIndicator postId='post-one'/>);
+        expect(queryByTestId('read_receipts.indicator.post-one')).toBeNull();
+        expect(fetchMissingProfilesByIds).not.toHaveBeenCalled();
+    });
+
+    it('shows exactly the authoritative reader identities among five members and updates per post', async () => {
+        const {database, operator} = DatabaseManager.getServerDatabaseAndOperator(serverUrl);
+        await operator.handleUsers({
