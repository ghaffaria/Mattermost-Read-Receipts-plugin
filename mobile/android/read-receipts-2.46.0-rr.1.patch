+jest.mock('@actions/local/channel', () => ({resetMessageCount: jest.fn().mockResolvedValue(undefined)}));
+jest.mock('@calls/hooks', () => ({useCallsAdjustment: jest.fn().mockReturnValue(80)}));
+jest.mock('@context/server', () => ({useServerUrl: () => 'https://local-banner-qa.invalid'}));
+
+const posts: PostList = Array.from({length: 8}, (_, index) => ({
+    type: 'post',
+    value: {currentPost: {id: `post-${index}`} as PostModel},
+}));
+const visible = (...indices: number[]): ViewToken[] => indices.map((index) => ({
+    index,
+    item: posts[index],
+    key: `row-${index}`,
+    isViewable: true,
+}));
+
+describe('MoreMessages native viewport reservation', () => {
+    let onVisible: ((tokens: ViewToken[]) => void) | undefined;
+    let onScrollEnd: ((index: number) => void) | undefined;
+    let unregisterVisible: jest.Mock;
+    let unregisterScroll: jest.Mock;
+    let baseProps: ComponentProps<typeof MoreMessages>;
+
+    beforeEach(() => {
+        jest.clearAllMocks();
+        jest.spyOn(EphemeralStore, 'isLoadingMessagesForChannel').mockReturnValue(false);
+        onVisible = undefined;
+        onScrollEnd = undefined;
+        unregisterVisible = jest.fn();
+        unregisterScroll = jest.fn();
+        baseProps = {
+            channelId: 'channel-one',
+            inline: true,
+            newMessageLineIndex: 6,
+            posts,
+            registerViewableItemsListener: jest.fn((listener) => {
+                onVisible = listener;
+                return unregisterVisible;
+            }),
+            registerScrollEndIndexListener: jest.fn((listener) => {
+                onScrollEnd = listener;
+                return unregisterScroll;
+            }),
+            scrollToIndex: jest.fn(),
+            unreadCount: 6,
+            theme: getDefaultThemeByAppearance(),
+            testID: 'more-messages',
+        };
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it('reserves zero space while hidden and exactly 56dp above the list when unread messages remain', async () => {
+        const {getByTestId, getByText, unmount} = renderWithIntlAndTheme(<MoreMessages {...baseProps}/>);
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0, overflow: 'hidden'});
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveProp('pointerEvents', 'none');
+        act(() => onVisible?.(visible(1, 2)));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 56});
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).not.toHaveStyle({position: 'absolute'});
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveProp('pointerEvents', 'auto');
+        expect(getByText('4 new messages')).toBeTruthy();
+        await act(async () => onVisible?.(visible(6)));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0});
+        expect(resetMessageCount).toHaveBeenCalledWith('https://local-banner-qa.invalid', 'channel-one');
+        unmount();
+    });
+
+    it('collapses immediately on cancel and remains hidden after the unread counter clears', () => {
+        const {getByTestId, rerender, unmount} = renderWithIntlAndTheme(<MoreMessages {...baseProps}/>);
+        act(() => onVisible?.(visible(1, 2)));
+        fireEvent.press(getByTestId('more-messages.cancel'));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0});
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveProp('importantForAccessibility', 'no-hide-descendants');
+        expect(resetMessageCount).toHaveBeenCalledTimes(1);
+        rerender(
+            <MoreMessages
+                {...baseProps}
+                unreadCount={0}
+            />,
+        );
+        act(() => onVisible?.(visible(1, 2)));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0});
+        unmount();
+    });
+
+    it('preserves jump-to-unread and the pressed guard until a scroll completes', () => {
+        const {getByTestId, unmount} = renderWithIntlAndTheme(<MoreMessages {...baseProps}/>);
+        act(() => onVisible?.(visible(1, 2)));
+        fireEvent.press(getByTestId('more-messages'));
+        fireEvent.press(getByTestId('more-messages'));
+        expect(baseProps.scrollToIndex).toHaveBeenCalledTimes(1);
+        expect(baseProps.scrollToIndex).toHaveBeenCalledWith(6, true);
+        act(() => onScrollEnd?.(6));
+        fireEvent.press(getByTestId('more-messages'));
+        expect(baseProps.scrollToIndex).toHaveBeenCalledTimes(2);
+        unmount();
+    });
+
+    it('preserves initial auto-scroll and hides the banner when the unread line is reached', async () => {
+        const {getByTestId, unmount} = renderWithIntlAndTheme(<MoreMessages {...baseProps}/>);
+        await act(async () => onVisible?.(visible(0, 6)));
+        expect(baseProps.scrollToIndex).toHaveBeenCalledWith(6, true, false);
+        expect(resetMessageCount).toHaveBeenCalledTimes(1);
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0});
+        unmount();
+    });
+
+    it('retains thread unread reset semantics without resetting the channel count', async () => {
+        const {getByTestId, unmount} = renderWithIntlAndTheme(
+            <MoreMessages
+                {...baseProps}
+                isCRTEnabled={true}
+                rootId='root-one'
+            />,
+        );
+        act(() => onVisible?.(visible(1, 2)));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 56});
+        await act(async () => onVisible?.(visible(6)));
+        act(() => onVisible?.(visible(1, 2)));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0});
+        expect(resetMessageCount).not.toHaveBeenCalled();
+        unmount();
+    });
+
+    it('does not open for manually unread or empty native visibility and unregisters both listeners', () => {
+        const {getByTestId, unmount} = renderWithIntlAndTheme(
+            <MoreMessages
+                {...baseProps}
+                isManualUnread={true}
+            />,
+        );
+        act(() => {
+            onVisible?.(visible(1, 2));
+            onVisible?.([]);
+        });
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({height: 0});
+        unmount();
+        expect(unregisterVisible).toHaveBeenCalledTimes(1);
+        expect(unregisterScroll).toHaveBeenCalledTimes(1);
+    });
+
+    it('keeps the legacy non-inline absolute layout', () => {
+        const {getByTestId, unmount} = renderWithIntlAndTheme(
+            <MoreMessages
+                {...baseProps}
+                inline={false}
+            />,
+        );
+        act(() => onVisible?.(visible(1, 2)));
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).toHaveStyle({position: 'absolute', padding: 8});
+        expect(getByTestId('more-messages.container', {includeHiddenElements: true})).not.toHaveStyle({height: 56});
+        unmount();
+    });
+});
