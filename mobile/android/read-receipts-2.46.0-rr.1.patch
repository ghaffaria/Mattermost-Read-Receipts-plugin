+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+import {Text} from 'react-native';
+
+import {render} from '@test/intl-test-helper';
+
+import {ReceiptOcclusionProvider, useReceiptOccluded, useReceiptOcclusion} from './occlusion';
+
+const Blocker = ({blocked}: {blocked: boolean}) => {
+    useReceiptOcclusion(blocked);
+    return null;
+};
+const Status = ({testID}: {testID: string}) => <Text testID={testID}>{String(useReceiptOccluded())}</Text>;
+
+describe('screen-scoped receipt occlusion', () => {
+    it('keeps independent blockers until the last overlay closes or unmounts', () => {
+        const tree = (first: boolean, second: boolean, mounted = true) => (
+            <ReceiptOcclusionProvider>
+                <Blocker blocked={first}/>
+                {mounted && <Blocker blocked={second}/>}
+                <Status testID='occluded'/>
+            </ReceiptOcclusionProvider>
+        );
+        const {getByTestId, rerender} = render(tree(true, true));
+        expect(getByTestId('occluded')).toHaveTextContent('true');
+        rerender(tree(false, true));
+        expect(getByTestId('occluded')).toHaveTextContent('true');
+        rerender(tree(false, true, false));
+        expect(getByTestId('occluded')).toHaveTextContent('false');
+    });
+
+    it('isolates screen providers and clears an old scope when the screen is replaced', () => {
+        const tree = (scope: string, blocked: boolean) => (
+            <>
+                <ReceiptOcclusionProvider key={scope}>
+                    <Blocker blocked={blocked}/>
+                    <Status testID='first'/>
+                </ReceiptOcclusionProvider>
+                <ReceiptOcclusionProvider>
+                    <Status testID='other'/>
+                </ReceiptOcclusionProvider>
+            </>
+        );
+        const {getByTestId, rerender} = render(tree('old-account-channel', true));
+        expect(getByTestId('first')).toHaveTextContent('true');
+        expect(getByTestId('other')).toHaveTextContent('false');
+        rerender(tree('new-account-channel', false));
+        expect(getByTestId('first')).toHaveTextContent('false');
+        expect(getByTestId('other')).toHaveTextContent('false');
+    });
+
+    it('leaves components outside a receipt screen unchanged', () => {
+        const {getByTestId} = render(
+            <>
+                <Blocker blocked={true}/>
+                <Status testID='outside'/>
+            </>,
+        );
+        expect(getByTestId('outside')).toHaveTextContent('false');
+    });
+});
