+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {NavigationContext} from '@react-navigation/native';
+import {useCallback, useContext, useLayoutEffect, useRef, useState} from 'react';
+import {AppState, NativeModules, Platform, type ViewToken} from 'react-native';
+
+import {Screens} from '@constants';
+import {useIsTablet} from '@hooks/device';
+import {NavigationStore} from '@store/navigation_store';
+
+import {createReceiptClient} from './client';
+import {ReadReceiptController} from './controller';
+import {useReceiptOccluded} from './occlusion';
+
+import type {ReceiptPost} from './types';
+import type {PostListItem, PostListOtherItem, ViewableItemsChanged} from '@typings/components/post_list';
+import type PostModel from '@typings/database/models/servers/post';
+import type {AvailableScreens} from '@typings/screens/navigation';
+
+export const RECEIPT_ITEM_VIEWABILITY_CONFIG = {
+    itemVisiblePercentThreshold: 50,
+    minimumViewTime: 0,
+};
+
+export const RECEIPT_AREA_VIEWABILITY_CONFIG = {
+    viewAreaCoveragePercentThreshold: 50,
+    minimumViewTime: 0,
+};
+
+type VisibleSources = {item: string[]; area: string[]};
+type ListScope = {
+    serverUrl: string;
+    userId: string;
+    channelId: string;
+    rootId?: string;
+    location: AvailableScreens;
+    posts: readonly PostModel[];
+};
+
+export const getVisibleReceiptPostIds = (tokens: ViewToken[]): string[] => tokens.flatMap((token) => {
+    const item = token.item as PostListItem | PostListOtherItem;
+    return token.isViewable && item?.type === 'post' ? [item.value.currentPost.id] : [];
+});
+
+export const mergeVisibleReceiptPostIds = (sources: VisibleSources): string[] => [...new Set([...sources.item, ...sources.area])];
+
+const receiptPost = (post: PostModel): ReceiptPost => ({
+    id: post.id,
+    channelId: post.channelId,
+    userId: post.userId,
+    deleteAt: post.deleteAt,
+    type: post.type,
+});
+
+const useReceiptAttention = (controller: ReadReceiptController | undefined, location: AvailableScreens) => {
+    const navigation = useContext(NavigationContext);
+    const isTablet = useIsTablet();
+    const occluded = useReceiptOccluded();
+
+    useLayoutEffect(() => {
+        if (!controller) {
+            return undefined;
+        }
+
+        const isAndroid = Platform.OS === 'android';
+        let appActive = AppState.currentState === 'active';
+        let windowFocused = !isAndroid;
+        let routeFocused = navigation?.isFocused() || false;
+        let visibleScreen: AvailableScreens | undefined = NavigationStore.getVisibleScreen();
+        let focusRevision = 0;
+        let probeRevision = 0;
+        let disposed = false;
+        const expectedScreen = isTablet && location === Screens.CHANNEL ? Screens.CHANNEL_LIST : location;
+
+        const update = () => {
+            if (!disposed) {
+                controller.setAttention(appActive && windowFocused && routeFocused && visibleScreen === expectedScreen && !occluded);
+            }
+        };
+        const probeWindowFocus = async () => {
+            const revision = focusRevision;
+            const request = ++probeRevision;
+            let focused = false;
+            try {
+                const nativeWindow = NativeModules.ReadReceiptsWindow as {hasWindowFocus?: () => Promise<boolean>} | undefined;
+                focused = (await nativeWindow?.hasWindowFocus?.()) === true;
+            } catch {
+                // Missing/unavailable native focus information must fail closed.
+            }
+
+            // A later blur/focus event is newer evidence than this async snapshot.
+            if (!disposed && revision === focusRevision && request === probeRevision) {
+                windowFocused = focused;
+                update();
+            }
+        };
+        const appStateSubscription = AppState.addEventListener('change', (state) => {
+            appActive = state === 'active';
+            if (isAndroid && !appActive) {
+                focusRevision += 1;
+                windowFocused = false;
+            }
+            update();
+            if (isAndroid && appActive && !windowFocused) {
+                probeWindowFocus();
+            }
+        });
+        const focusSubscription = isAndroid ? AppState.addEventListener('focus', () => {
+            focusRevision += 1;
+            windowFocused = true;
+            update();
+        }) : undefined;
+        const blurSubscription = isAndroid ? AppState.addEventListener('blur', () => {
+            // Android notification shade does not necessarily change AppState.
+            focusRevision += 1;
+            windowFocused = false;
+            update();
+        }) : undefined;
+        const removeFocus = navigation?.addListener('focus', () => {
+            routeFocused = true;
+            update();
+        });
+        const removeBlur = navigation?.addListener('blur', () => {
+            routeFocused = false;
+            update();
+        });
+        const screenSubscription = NavigationStore.currentScreen$.subscribe((screen) => {
+            // A bottom sheet/modal can leave the underlying route focused.
+            visibleScreen = screen;
+            update();
+        });
+
+        update();
+        if (isAndroid && appActive) {
+            // Register focus/blur listeners before requesting an initial snapshot.
+            probeWindowFocus();
+        }
+        return () => {
+            disposed = true;
+            controller.setAttention(false);
+            appStateSubscription.remove();
+            focusSubscription?.remove();
+            blurSubscription?.remove();
+            removeFocus?.();
+            removeBlur?.();
+            screenSubscription.unsubscribe();
+        };
+    }, [controller, isTablet, location, navigation, occluded]);
+};
+
+export const useReadReceiptList = ({serverUrl, userId, channelId, rootId, location, posts}: ListScope) => {
+    const scope = JSON.stringify([serverUrl, userId, channelId, rootId || '', location]);
+    const latestPosts = useRef(posts);
+    latestPosts.current = posts;
+    const visible = useRef<{scope: string; sources: VisibleSources}>({scope, sources: {item: [], area: []}});
+    const [instance, setInstance] = useState<{scope: string; controller: ReadReceiptController}>();
+    const controller = instance?.scope === scope ? instance.controller : undefined;
+    const current = useRef({scope, controller});
+    current.current = {scope, controller};
+
+    useLayoutEffect(() => {
+        if (!serverUrl || !userId) {
+            return undefined;
+        }
+        const created = new ReadReceiptController({userId, client: createReceiptClient(serverUrl)});
+        created.setPosts(latestPosts.current.map(receiptPost));
+        if (visible.current.scope === scope) {
+            created.setVisible(mergeVisibleReceiptPostIds(visible.current.sources));
+        } else {
+            visible.current = {scope, sources: {item: [], area: []}};
+        }
+        setInstance({scope, controller: created});
+        return () => created.dispose();
+    }, [scope, serverUrl, userId]);
+
+    useLayoutEffect(() => {
+        controller?.setPosts(posts.map(receiptPost));
+    }, [controller, posts]);
+
+    useReceiptAttention(controller, location);
+
+    const setVisible = useCallback((source: keyof VisibleSources, viewableItems: ViewToken[]) => {
+        const currentScope = current.current.scope;
+        if (visible.current.scope !== currentScope) {
+            visible.current = {scope: currentScope, sources: {item: [], area: []}};
+        }
+        visible.current.sources[source] = getVisibleReceiptPostIds(viewableItems);
+        current.current.controller?.setVisible(mergeVisibleReceiptPostIds(visible.current.sources));
+    }, []);
+
+    // Callback identities must remain unchanged throughout the FlatList lifetime.
+    const onItemViewableItemsChanged = useCallback(({viewableItems}: ViewableItemsChanged) => {
+        setVisible('item', viewableItems);
+    }, [setVisible]);
+    const onAreaViewableItemsChanged = useCallback(({viewableItems}: ViewableItemsChanged) => {
+        setVisible('area', viewableItems);
+    }, [setVisible]);
+
+    return {controller, listKey: scope, onItemViewableItemsChanged, onAreaViewableItemsChanged};
+};
