+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {advanceTimers, disableFakeTimers, enableFakeTimers} from '@test/timer_helpers';
+
+import {ReadReceiptController} from './controller';
+
+import type {Receipt, ReceiptClient, ReceiptConfig, ReceiptPost} from './types';
+
+const incoming: ReceiptPost = {id: 'message', channelId: 'channel', userId: 'author'};
+const own: ReceiptPost = {id: 'own-message', channelId: 'channel', userId: 'viewer'};
+const enabled: ReceiptConfig = {enable: true, visibility_threshold_ms: 2000};
+const controllers: ReadReceiptController[] = [];
+
+function deferred<T>() {
+    let resolve: (value: T) => void = () => {};
+    const promise = new Promise<T>((res) => {
+        resolve = res;
+    });
+    return {promise, resolve};
+}
+
+function receipt(post: ReceiptPost, userId = 'reader', timestamp = 12345): Receipt {
+    return {MessageID: post.id, ChannelID: post.channelId, UserID: userId, Timestamp: timestamp};
+}
+
+function clientMock(): jest.Mocked<ReceiptClient> {
+    return {
+        getConfig: jest.fn().mockResolvedValue(enabled),
+        getReceipts: jest.fn().mockResolvedValue([]),
+        markRead: jest.fn().mockResolvedValue({status: 'ok'}),
+    };
+}
+
+async function create(client = clientMock(), userId = 'viewer') {
+    const controller = new ReadReceiptController({client, userId});
+    controllers.push(controller);
+    await advanceTimers(0);
+    return {client, controller};
+}
+
+async function show(controller: ReadReceiptController, posts: ReceiptPost[] = [incoming]) {
+    controller.setPosts(posts);
+    controller.setVisible(posts.map((post) => post.id));
+    controller.setAttention(true);
+    await advanceTimers(0);
+}
+
+beforeEach(() => {
+    enableFakeTimers();
+    jest.setSystemTime(100000);
+});
+
+afterEach(() => {
+    controllers.splice(0).forEach((controller) => controller.dispose());
+    disableFakeTimers();
+});
+
+describe('native explicit read receipts', () => {
+    it('should write only a visible eligible incoming message after the full configured dwell', async () => {
+        const {client, controller} = await create();
+        const offscreen = {...incoming, id: 'offscreen'};
+        const deleted = {...incoming, id: 'deleted', deleteAt: 1};
+        const system = {...incoming, id: 'system', type: 'system_join_channel'};
+        const placeholder = {...incoming, id: 'unrevealed', type: 'custom_burn_on_read'};
+        controller.setPosts([incoming, offscreen, deleted, system, placeholder, own]);
+        controller.setVisible([incoming.id, deleted.id, system.id, placeholder.id, own.id, 'unknown']);
+        controller.setAttention(true);
+        await advanceTimers(1999);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await advanceTimers(1);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        expect(client.markRead).toHaveBeenCalledWith(incoming);
+        expect(controller.getReaders(incoming.id)).toHaveLength(0);
+    });
+
+    it('should discard interrupted visibility instead of accumulating time across scrolls', async () => {
+        const {client, controller} = await create();
+        await show(controller);
+        await advanceTimers(1000);
+        controller.setVisible([]);
+        await advanceTimers(3000);
+        controller.setVisible([incoming.id]);
+        await advanceTimers(1999);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await advanceTimers(1);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+    });
+
+    it('should require a fresh dwell and configuration check after a background or focus interruption', async () => {
+        const {client, controller} = await create();
+        await show(controller);
+        await advanceTimers(1500);
+        controller.setAttention(false);
+        await advanceTimers(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        controller.setAttention(true);
+        await advanceTimers(0);
+        expect(client.getConfig).toHaveBeenCalledTimes(2);
+        await advanceTimers(1999);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await advanceTimers(1);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+    });
+
+    it('should keep offscreen and unknown posts unread even after the channel has been open for a long time', async () => {
+        const {client, controller} = await create();
+        controller.setPosts([incoming]);
+        controller.setVisible(['not-loaded']);
+        controller.setAttention(true);
+        await advanceTimers(10000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        expect(client.getReceipts).not.toHaveBeenCalled();
+    });
+
+    it('should honor a zero threshold without requiring a timer tick', async () => {
+        const client = clientMock();
+        client.getConfig.mockResolvedValue({enable: true, visibility_threshold_ms: 0});
+        const {controller} = await create(client);
+        await show(controller);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+    });
+
+    it('should use the actual thread post channel for both reads and receipt history', async () => {
+        const {client, controller} = await create();
+        const reply = {...incoming, id: 'reply', channelId: 'thread-channel'};
+        controller.setPosts([incoming, reply]);
+        controller.setVisible([reply.id]);
+        controller.setAttention(true);
+        await advanceTimers(2000);
+        expect(client.getReceipts).toHaveBeenCalledWith(reply.channelId, [reply.id]);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        expect(client.markRead).toHaveBeenCalledWith(reply);
+    });
+
+    it('should hydrate exact readers for authored posts without writing sender or inherited receipts', async () => {
+        const client = clientMock();
+        const first = receipt(own, 'reader-one');
+        const second = receipt(own, 'reader-two', 12346);
+        client.getReceipts.mockResolvedValue([first, second, receipt(own, own.userId), {...first, ChannelID: 'other-channel'}, {...first, MessageID: 'other-post'}]);
+        const {controller} = await create(client);
+        await show(controller, [own]);
+        expect(controller.getReaders(own.id)).toEqual([first, second]);
+        expect(controller.getReaders('other-post')).toHaveLength(0);
+        await advanceTimers(5000);
+        expect(client.markRead).not.toHaveBeenCalled();
+    });
+
+    it('should replace removed history and preserve snapshot identity when history has not changed', async () => {
+        const client = clientMock();
+        client.getReceipts.mockResolvedValue([receipt(own)]);
+        const {controller} = await create(client);
+        const listener = jest.fn();
+        controller.subscribe(listener);
+        await show(controller, [own]);
+        const first = controller.getReaders(own.id);
+        const notifications = listener.mock.calls.length;
+        await advanceTimers(3000);
+        expect(controller.getReaders(own.id)).toBe(first);
+        expect(listener).toHaveBeenCalledTimes(notifications);
+        client.getReceipts.mockResolvedValue([]);
+        await advanceTimers(3000);
+        expect(controller.getReaders(own.id)).toHaveLength(0);
+        expect(listener).toHaveBeenCalledTimes(notifications + 1);
+    });
+
+    it('should deduplicate in-flight writes and display only authoritative server receipts after acknowledgement', async () => {
+        const client = clientMock();
+        const write = deferred<unknown>();
+        client.markRead.mockReturnValue(write.promise);
+        const {controller} = await create(client);
+        await show(controller);
+        await advanceTimers(5000);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        expect(controller.getReaders(incoming.id)).toHaveLength(0);
+        const actual = receipt(incoming, 'viewer', 777);
+        client.getReceipts.mockResolvedValue([actual]);
+        write.resolve({status: 'ok'});
+        await advanceTimers(0);
+        await advanceTimers(250);
+        expect(controller.getReaders(incoming.id)).toEqual([actual]);
+        await advanceTimers(5000);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+    });
+
+    it('should retry a transient failure only after backoff and another full visible interval', async () => {
+        const client = clientMock();
+        client.markRead.mockRejectedValueOnce(new Error('Temporary network failure'));
+        const {controller} = await create(client);
+        await show(controller);
+        await advanceTimers(2000);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        await advanceTimers(2999);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+        await advanceTimers(1);
+        expect(client.markRead).toHaveBeenCalledTimes(2);
+    });
+
+    it('should stop retrying a forbidden channel instead of spamming another visible message', async () => {
+        const client = clientMock();
+        client.markRead.mockRejectedValue({status_code: 403});
+        const {controller} = await create(client);
+        await show(controller);
+        await advanceTimers(2000);
+        const another = {...incoming, id: 'another-message'};
+        controller.setPosts([incoming, another]);
+        controller.setVisible([incoming.id, another.id]);
+        await advanceTimers(10000);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+    });
+
+    it('should hide forbidden receipt history and pause polling for that channel', async () => {
+        const client = clientMock();
+        client.getReceipts.mockResolvedValueOnce([receipt(own)]).mockRejectedValue({status_code: 403});
+        const {controller} = await create(client);
+        await show(controller, [own]);
+        expect(controller.getReaders(own.id)).toHaveLength(1);
+        await advanceTimers(3000);
+        expect(controller.getReaders(own.id)).toHaveLength(0);
+        await advanceTimers(9000);
+        expect(client.getReceipts).toHaveBeenCalledTimes(2);
+        expect(client.markRead).not.toHaveBeenCalled();
+    });
+
+    it('should fail closed when the optional server plugin is missing', async () => {
+        const client = clientMock();
+        client.getConfig.mockRejectedValue({status_code: 404});
+        const {controller} = await create(client);
+        await show(controller);
+        await advanceTimers(20000);
+        expect(client.getConfig).toHaveBeenCalledTimes(1);
+        expect(client.markRead).not.toHaveBeenCalled();
+        expect(client.getReceipts).not.toHaveBeenCalled();
+    });
+
+    it('should stop pending dwell when a configuration refresh disables the plugin', async () => {
+        const client = clientMock();
+        client.getConfig.mockResolvedValueOnce({enable: true, visibility_threshold_ms: 30000}).mockResolvedValue({enable: false, visibility_threshold_ms: 30000});
+        const {controller} = await create(client);
+        await show(controller);
+        await advanceTimers(15000);
+        await advanceTimers(30000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        expect(controller.getReaders(incoming.id)).toHaveLength(0);
+    });
+
+    it('should not count visible time spent waiting for the initial configuration', async () => {
+        const client = clientMock();
+        const configuration = deferred<ReceiptConfig>();
+        client.getConfig.mockReturnValue(configuration.promise);
+        const {controller} = await create(client);
+        await show(controller);
+        await advanceTimers(10000);
+        expect(client.markRead).not.toHaveBeenCalled();
+        configuration.resolve(enabled);
+        await advanceTimers(0);
+        await advanceTimers(1999);
+        expect(client.markRead).not.toHaveBeenCalled();
+        await advanceTimers(1);
+        expect(client.markRead).toHaveBeenCalledTimes(1);
+    });
+
+    it('should batch large visible sets within the server limit and never write authored posts', async () => {
+        const {client, controller} = await create();
+        const posts = Array.from({length: 201}, (_, index) => ({...own, id: `own-${index}`}));
+        await show(controller, posts);
+        expect(client.getReceipts.mock.calls.map(([, ids]) => ids.length)).toEqual([200, 1]);
+        expect(client.markRead).not.toHaveBeenCalled();
+    });
+
+    it('should discard late responses on disposal without leaking them into another account session', async () => {
+        const client = clientMock();
+        const response = deferred<Receipt[]>();
+        client.getReceipts.mockReturnValue(response.promise);
+        const baseline = jest.getTimerCount();
+        const {controller} = await create(client);
+        const listener = jest.fn();
+        await show(controller, [own]);
+        controller.subscribe(listener);
+        expect(jest.getTimerCount()).toBe(baseline + 1);
+        controller.dispose();
+        response.resolve([receipt(own)]);
+        await advanceTimers(0);
+        expect(controller.getReaders(own.id)).toHaveLength(0);
+        expect(listener).not.toHaveBeenCalled();
+        expect(jest.getTimerCount()).toBe(baseline);
+        const other = await create(clientMock(), 'another-viewer');
+        other.controller.setPosts([own]);
+        expect(other.controller.getReaders(own.id)).toHaveLength(0);
+    });
+});
