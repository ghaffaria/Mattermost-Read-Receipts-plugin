@@ -0,0 +1,376 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {Receipt, ReceiptClient, ReceiptConfig, ReceiptPost} from './types';
+
+const SCAN_INTERVAL_MS = 250;
+const HYDRATE_INTERVAL_MS = 3000;
+const CONFIG_INTERVAL_MS = 15000;
+const UNAVAILABLE_RETRY_MS = 30000;
+const MAX_BATCH_SIZE = 200;
+const MAX_CACHED_POSTS = 500;
+const MAX_PENDING_WRITES = 4;
+const EMPTY_RECEIPTS: readonly Receipt[] = Object.freeze([]);
+
+function errorStatus(error: unknown): number | undefined {
+    if (error && typeof error === 'object' && 'status_code' in error && typeof error.status_code === 'number') {
+        return error.status_code;
+    }
+    return undefined;
+}
+
+function sameReaders(left: readonly Receipt[], right: readonly Receipt[]): boolean {
+    return left.length === right.length && left.every((receipt, index) => {
+        const other = right[index];
+        return receipt.UserID === other.UserID && receipt.Timestamp === other.Timestamp &&
+            receipt.ChannelID === other.ChannelID && receipt.MessageID === other.MessageID;
+    });
+}
+
+function eligible(post: ReceiptPost): boolean {
+    // Custom types can render an unrevealed burn-on-read or other non-message placeholder.
+    return Boolean(post.id && post.channelId && post.userId && !post.deleteAt && !post.type);
+}
+
+/** One list/account session. Visibility comes from the native list, never the channel cursor. */
+export class ReadReceiptController {
+    private readonly userId: string;
+    private readonly client: ReceiptClient;
+    private readonly timer: ReturnType<typeof setInterval>;
+    private posts = new Map<string, ReceiptPost>();
+    private visible = new Set<string>();
+    private starts = new Map<string, number>();
+    private pending = new Set<string>();
+    private acknowledged = new Set<string>();
+    private retries = new Map<string, {at: number; attempts: number}>();
+    private blockedChannels = new Map<string, number>();
+    private rejectedPosts = new Set<string>();
+    private readers = new Map<string, readonly Receipt[]>();
+    private listeners = new Set<() => void>();
+    private config: ReceiptConfig | undefined;
+    private configPending = false;
+    private configEpoch = 0;
+    private nextConfigAt = 0;
+    private lastHydrateAt = 0;
+    private hydrateRequested = true;
+    private hydrating = false;
+    private attention = false;
+    private hasBeenActive = false;
+    private disposed = false;
+
+    constructor({userId, client}: {userId: string; client: ReceiptClient}) {
+        this.userId = userId;
+        this.client = client;
+        this.timer = setInterval(() => this.scan(), SCAN_INTERVAL_MS);
+        this.loadConfig();
+    }
+
+    public setPosts = (posts: readonly ReceiptPost[]): void => {
+        if (this.disposed) {
+            return;
+        }
+        const next = new Map<string, ReceiptPost>();
+        for (const post of posts) {
+            // Watermelon models can mutate in place; keep primitive identity fields.
+            next.set(post.id, {id: post.id, channelId: post.channelId, userId: post.userId, deleteAt: post.deleteAt, type: post.type});
+        }
+        let changed = next.size !== this.posts.size;
+        for (const [id, post] of next) {
+            const previous = this.posts.get(id);
+            if (!previous || previous.channelId !== post.channelId || previous.userId !== post.userId ||
+                previous.deleteAt !== post.deleteAt || previous.type !== post.type) {
+                this.starts.delete(id);
+                this.rejectedPosts.delete(id);
+                changed = true;
+            }
+        }
+        this.posts = next;
+        for (const state of [this.starts, this.acknowledged, this.retries, this.readers, this.rejectedPosts]) {
+            for (const id of state.keys()) {
+                if (!next.has(id) || !eligible(next.get(id) as ReceiptPost)) {
+                    state.delete(id);
+                    changed = true;
+                }
+            }
+        }
+        if (changed) {
+            this.hydrateRequested = true;
+            this.notify();
+        }
+        this.scan();
+    };
+
+    public setVisible = (postIds: readonly string[]): void => {
+        if (this.disposed) {
+            return;
+        }
+        const next = new Set(postIds);
+        if (next.size === this.visible.size && [...next].every((id) => this.visible.has(id))) {
+            return;
+        }
+        this.visible = next;
+        for (const id of this.starts.keys()) {
+            if (!next.has(id)) {
+                this.starts.delete(id);
+            }
+        }
+        this.hydrateRequested = true;
+        this.scan();
+    };
+
+    public setAttention = (attention: boolean): void => {
+        if (this.disposed || this.attention === attention) {
+            return;
+        }
+        this.attention = attention;
+        this.starts.clear();
+        if (attention) {
+            this.hydrateRequested = true;
+
+            // A foreground return must recheck a plugin disabled while away.
+            if (this.hasBeenActive) {
+                this.nextConfigAt = 0;
+            }
+            this.hasBeenActive = true;
+        }
+        this.scan();
+    };
+
+    public getReaders = (postId: string): readonly Receipt[] => this.readers.get(postId) ?? EMPTY_RECEIPTS;
+
+    public subscribe = (listener: () => void): (() => void) => {
+        if (!this.disposed) {
+            this.listeners.add(listener);
+        }
+        return () => this.listeners.delete(listener);
+    };
+
+    public dispose = (): void => {
+        this.disposed = true;
+        clearInterval(this.timer);
+        this.starts.clear();
+        this.visible.clear();
+        this.posts.clear();
+        this.pending.clear();
+        this.acknowledged.clear();
+        this.retries.clear();
+        this.blockedChannels.clear();
+        this.rejectedPosts.clear();
+        this.readers.clear();
+        this.listeners.clear();
+    };
+
+    private notify(): void {
+        this.listeners.forEach((listener) => listener());
+    }
+
+    private unavailable(): void {
+        this.config = undefined;
+        this.configEpoch += 1;
+        this.nextConfigAt = Date.now() + UNAVAILABLE_RETRY_MS;
+        this.starts.clear();
+        this.readers.clear();
+        this.notify();
+    }
+
+    private blockChannel(channelId: string): void {
+        this.blockedChannels.set(channelId, Date.now() + UNAVAILABLE_RETRY_MS);
+        for (const [id, post] of this.posts) {
+            if (post.channelId === channelId) {
+                this.readers.delete(id);
+                this.starts.delete(id);
+            }
+        }
+        this.notify();
+    }
+
+    private async loadConfig(): Promise<void> {
+        this.configPending = true;
+        try {
+            const config = await this.client.getConfig();
+            if (this.disposed) {
+                return;
+            }
+            if (typeof config.enable !== 'boolean' || !Number.isFinite(config.visibility_threshold_ms) || config.visibility_threshold_ms < 0) {
+                this.unavailable();
+                return;
+            }
+            if (!config.enable || this.config?.visibility_threshold_ms !== config.visibility_threshold_ms) {
+                this.starts.clear();
+                this.configEpoch += 1;
+            }
+            this.config = config;
+            this.nextConfigAt = Date.now() + CONFIG_INTERVAL_MS;
+            if (!config.enable) {
+                this.readers.clear();
+                this.notify();
+            }
+            this.hydrateRequested = true;
+        } catch {
+            // An optional plugin may be absent, disabled, or unreachable: fail closed.
+            if (!this.disposed) {
+                this.unavailable();
+            }
+        } finally {
+            this.configPending = false;
+            this.scan();
+        }
+    }
+
+    private scan(): void {
+        if (this.disposed || !this.attention) {
+            return;
+        }
+        const now = Date.now();
+        if (!this.configPending && now >= this.nextConfigAt) {
+            this.loadConfig();
+        }
+        if (this.configPending || !this.config?.enable) {
+            return;
+        }
+        if (this.hydrateRequested || now - this.lastHydrateAt >= HYDRATE_INTERVAL_MS) {
+            this.hydrate();
+        }
+        for (const id of this.visible) {
+            const post = this.posts.get(id);
+            if (!post || !eligible(post) || post.userId === this.userId || this.acknowledged.has(id) ||
+                this.getReaders(id).some((receipt) => receipt.UserID === this.userId) || this.rejectedPosts.has(id) ||
+                (this.blockedChannels.get(post.channelId) ?? 0) > now || (this.retries.get(id)?.at ?? 0) > now) {
+                this.starts.delete(id);
+                continue;
+            }
+            const startedAt = this.starts.get(id) ?? now;
+            this.starts.set(id, startedAt);
+            if (now - startedAt >= this.config.visibility_threshold_ms && !this.pending.has(id) && this.pending.size < MAX_PENDING_WRITES) {
+                this.markRead(post);
+            }
+        }
+    }
+
+    private async markRead(post: ReceiptPost): Promise<void> {
+        this.pending.add(post.id);
+        this.starts.delete(post.id);
+        try {
+            await this.client.markRead(post);
+            if (!this.disposed) {
+                this.acknowledged.add(post.id);
+                this.retries.delete(post.id);
+                while (this.acknowledged.size > MAX_CACHED_POSTS) {
+                    this.acknowledged.delete(this.acknowledged.values().next().value as string);
+                }
+
+                // The acknowledgement stops duplicate writes; only GET supplies display data.
+                this.hydrateRequested = true;
+            }
+        } catch (error) {
+            if (!this.disposed) {
+                this.starts.delete(post.id);
+                const status = errorStatus(error);
+                if (status === 403 || status === 401) {
+                    this.blockChannel(post.channelId);
+                } else if (status === 404 || status === 503) {
+                    this.unavailable();
+                } else if (status === 400) {
+                    this.rejectedPosts.add(post.id);
+                } else {
+                    const attempts = (this.retries.get(post.id)?.attempts ?? 0) + 1;
+                    this.retries.set(post.id, {attempts, at: Date.now() + Math.min(1000 * (2 ** (attempts - 1)), UNAVAILABLE_RETRY_MS)});
+                }
+            }
+        } finally {
+            this.pending.delete(post.id);
+        }
+    }
+
+    private async hydrate(): Promise<void> {
+        if (this.hydrating || !this.config?.enable || !this.attention || this.disposed) {
+            return;
+        }
+        this.hydrating = true;
+        this.hydrateRequested = false;
+        this.lastHydrateAt = Date.now();
+        const epoch = this.configEpoch;
+        const channels = new Map<string, string[]>();
+        for (const id of this.visible) {
+            const post = this.posts.get(id);
+            if (post && eligible(post) && (this.blockedChannels.get(post.channelId) ?? 0) <= Date.now()) {
+                const ids = channels.get(post.channelId) ?? [];
+                ids.push(id);
+                channels.set(post.channelId, ids);
+            }
+        }
+        try {
+            // Native viewability limits the set; batches also honor the server's 200-ID limit.
+            for (const [channelId, ids] of channels) {
+                for (let offset = 0; offset < ids.length; offset += MAX_BATCH_SIZE) {
+                    if (this.disposed || epoch !== this.configEpoch || !this.attention) {
+                        return;
+                    }
+                    if ((this.blockedChannels.get(channelId) ?? 0) > Date.now()) {
+                        break;
+                    }
+                    const batch = ids.slice(offset, offset + MAX_BATCH_SIZE);
+
+                    // Serialize batches to bound native HTTP concurrency regardless of list size.
+                    // eslint-disable-next-line no-await-in-loop
+                    await this.hydrateBatch(channelId, batch, epoch);
+                }
+            }
+        } finally {
+            this.hydrating = false;
+        }
+    }
+
+    private async hydrateBatch(channelId: string, ids: string[], epoch: number): Promise<void> {
+        try {
+            const receipts = await this.client.getReceipts(channelId, ids);
+            if (this.disposed || epoch !== this.configEpoch || !this.config?.enable) {
+                return;
+            }
+            const requested = new Set(ids);
+            const grouped = new Map<string, Map<string, Receipt>>();
+            for (const receipt of receipts) {
+                const post = this.posts.get(receipt.MessageID);
+                if (!post || !eligible(post) || post.channelId !== channelId || receipt.ChannelID !== channelId ||
+                    !requested.has(receipt.MessageID) || !receipt.UserID || receipt.UserID === post.userId || !Number.isFinite(receipt.Timestamp)) {
+                    continue;
+                }
+                const readers = grouped.get(receipt.MessageID) ?? new Map<string, Receipt>();
+                const previous = readers.get(receipt.UserID);
+                if (!previous || receipt.Timestamp < previous.Timestamp) {
+                    readers.set(receipt.UserID, Object.freeze({...receipt}));
+                }
+                grouped.set(receipt.MessageID, readers);
+            }
+            let changed = false;
+            for (const id of ids) {
+                if (this.posts.get(id)?.channelId !== channelId) {
+                    continue;
+                }
+                const next = [...(grouped.get(id)?.values() ?? [])].sort((a, b) => a.Timestamp - b.Timestamp || a.UserID.localeCompare(b.UserID));
+                if (!sameReaders(this.getReaders(id), next)) {
+                    this.readers.set(id, next.length ? Object.freeze(next) : EMPTY_RECEIPTS);
+                    changed = true;
+                }
+            }
+            while (this.readers.size > MAX_CACHED_POSTS) {
+                this.readers.delete(this.readers.keys().next().value as string);
+            }
+            if (changed) {
+                this.notify();
+            }
+        } catch (error) {
+            if (this.disposed || epoch !== this.configEpoch) {
+                return;
+            }
+            const status = errorStatus(error);
+            if (status === 403 || status === 401) {
+                this.blockChannel(channelId);
+            } else if (status === 404 || status === 503) {
+                this.unavailable();
+            }
+
+            // Other read errors retry at the next bounded foreground hydration interval.
+        }
+    }
+}
