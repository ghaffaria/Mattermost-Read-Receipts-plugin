+        rerender(tree({showIncomingCalls: true, channelId: 'current-channel'}));
+        expect(getByTestId('receipt-occluded')).toHaveTextContent('false');
+    });
+
+    it.each([{isInACall: true}, {showJoinCallBanner: true, channelId: 'current-channel'}])('blocks rendered call/join bars and cleans up on unmount: %s', (props) => {
+        const {getByTestId, rerender} = renderWithIntlAndTheme(tree(props));
+        expect(getByTestId('receipt-occluded')).toHaveTextContent('true');
